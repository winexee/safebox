#!/usr/bin/env bash
# SafeBox RootFS Kurulum Betiği (v1.7.6)
# Bu betik sandbox için gerekli rootfs'i oluşturur.
# Root (sudo) yetkisi gerektirir.
set -euo pipefail

ROOTFS_DIR="/var/lib/safebox/rootfs"
DISTRO="noble"  # Ubuntu 24.04 LTS

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

print_info()  { echo -e "${BLUE}[BİLGİ]${NC} $1"; }
print_ok()    { echo -e "${GREEN}[  OK ]${NC} $1"; }
print_warn()  { echo -e "${YELLOW}[UYARI]${NC} $1"; }
print_error() { echo -e "${RED}[HATA]${NC} $1"; }

# Root kontrolü
if [ "$(id -u)" -ne 0 ]; then
    print_error "Bu betik root yetkisi gerektirir!"
    echo "Kullanım: sudo safebox-setup"
    exit 1
fi

# Zaten kurulu mu kontrol et
if [ -f "$ROOTFS_DIR/.safebox-rootfs-complete" ]; then
    print_warn "RootFS zaten mevcut ve tam: $ROOTFS_DIR"
    read -rp "Yeniden oluşturmak istiyor musunuz? [e/H]: " choice
    if [[ ! "$choice" =~ ^[eEyY]$ ]]; then
        print_info "Kurulum iptal edildi."
        exit 0
    fi
    print_info "Mevcut rootfs yedekleniyor (.old)..."
    rm -rf "${ROOTFS_DIR}.old"
    mv "$ROOTFS_DIR" "${ROOTFS_DIR}.old"
elif [ -d "$ROOTFS_DIR" ]; then
    print_info "Tamamlanmamış rootfs bulundu, temizleniyor..."
    rm -rf "$ROOTFS_DIR"
fi

# Yarım kalmış bir geçici klasör varsa sil
ROOTFS_TMP="${ROOTFS_DIR}.tmp"
rm -rf "$ROOTFS_TMP"

# Hata yakalama: Hata olursa yedeği geri yükle
trap 'if [ -d "${ROOTFS_DIR}.old" ] && [ ! -d "$ROOTFS_DIR" ]; then print_warn "Kurulum başarısız, eski rootfs geri yükleniyor..."; mv "${ROOTFS_DIR}.old" "$ROOTFS_DIR"; fi; exit 1' ERR INT TERM

# Bağımlılıkları kontrol et
print_info "Bağımlılıklar kontrol ediliyor..."
MISSING_DEPS=()

for dep in debootstrap bubblewrap Xephyr; do
    case "$dep" in
        Xephyr)
            if ! command -v Xephyr &>/dev/null; then
                MISSING_DEPS+=("xserver-xephyr")
            fi
            ;;
        *)
            if ! command -v "$dep" &>/dev/null; then
                MISSING_DEPS+=("$dep")
            fi
            ;;
    esac
done

if [ ${#MISSING_DEPS[@]} -gt 0 ]; then
    print_info "Eksik paketler kuruluyor: ${MISSING_DEPS[*]}"
    apt-get update -qq
    apt-get install -y -qq "${MISSING_DEPS[@]}"
fi

print_ok "Bağımlılıklar hazır."

# RootFS oluştur
print_info "RootFS oluşturuluyor (bu işlem birkaç dakika sürebilir)..."
mkdir -p "$ROOTFS_TMP"

debootstrap \
    --variant=minbase \
    --include=cinnamon-core,cinnamon-session,nemo,xed,gnome-terminal,firefox,gnome-system-monitor,dbus-x11,locales,fonts-noto,fonts-noto-color-emoji,adwaita-icon-theme \
    "$DISTRO" \
    "$ROOTFS_TMP" \
    http://archive.ubuntu.com/ubuntu

print_ok "Temel sistem oluşturuldu."

# Locale ayarla
print_info "Türkçe dil desteği ayarlanıyor..."
chroot "$ROOTFS_TMP" /bin/bash -c "
    sed -i 's/# tr_TR.UTF-8 UTF-8/tr_TR.UTF-8 UTF-8/' /etc/locale.gen 2>/dev/null || true
    locale-gen tr_TR.UTF-8 2>/dev/null || true
"
print_ok "Dil desteği ayarlandı."

# Gereksiz dosyaları temizle (boyutu küçült)
print_info "Gereksiz dosyalar temizleniyor..."
chroot "$ROOTFS_TMP" /bin/bash -c "
    apt-get clean
    rm -rf /var/lib/apt/lists/*
    rm -rf /usr/share/doc/*
    rm -rf /usr/share/man/*
    rm -rf /var/cache/*
    rm -rf /tmp/*
"
print_ok "Temizlik tamamlandı."

# Kurulumun tamamlandığını belirten bayrak dosyasını ekle
touch "$ROOTFS_TMP/.safebox-rootfs-complete"

# Hata tuzağını kaldır
trap - ERR INT TERM

# Atomik olarak taşı
rm -rf "$ROOTFS_DIR"
mv "$ROOTFS_TMP" "$ROOTFS_DIR"
rm -rf "${ROOTFS_DIR}.old"

# Boyut bilgisi
ROOTFS_SIZE=$(du -sh "$ROOTFS_DIR" 2>/dev/null | cut -f1)
print_ok "RootFS hazır!"

echo ""
echo "════════════════════════════════════════════════"
echo -e "  ${GREEN}✅ SafeBox RootFS kurulumu tamamlandı!${NC}"
echo ""
echo "  Konum : $ROOTFS_DIR"
echo "  Boyut : $ROOTFS_SIZE"
echo "  Distro: Ubuntu $DISTRO (24.04 LTS)"
echo "  DE    : Cinnamon"
echo ""
echo "  Artık SafeBox'ı başlatabilirsiniz:"
echo "    safebox"
echo "════════════════════════════════════════════════"
