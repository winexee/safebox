#!/usr/bin/env bash
# SafeBox Enterprise Hardened Engine (v1.7.5)
set -euo pipefail

# XDG runtime dizini her çağrıda mevcut olmayabilir.
# Özellikle doğrudan çalıştırma ve minimal session ortamlarında güvenli varsayılan kullan.
if [ -z "${XDG_RUNTIME_DIR:-}" ]; then
    XDG_RUNTIME_DIR="/run/user/$(id -u)"
    export XDG_RUNTIME_DIR
fi

RAM_GB="${1:-4}"
CPU_CORES="${2:-4}"
RESOLUTION="${3:-1366x768}"
SHARE_FOLDER="${4:-1}"
CLIPBOARD="${5:-1}"
AUDIO="${6:-1}"
NET="${7:-1}"

LOG_DIR="${HOME}/.local/share/safebox"
DISPLAY_FILE="${LOG_DIR}/display"
PROC_MOCK_DIR="${LOG_DIR}/mock_proc"
SYS_MOCK_DIR="${LOG_DIR}/mock_sys"
ETC_MOCK_DIR="${LOG_DIR}/mock_etc"
ENGINE_LOG="${LOG_DIR}/safebox-engine.log"
mkdir -p "$LOG_DIR" "$PROC_MOCK_DIR" "$SYS_MOCK_DIR/devices/system/cpu" "$ETC_MOCK_DIR"

echo "=== [$(date '+%Y-%m-%d %H:%M:%S')] SafeBox Engine v1.7.5 Başlatılıyor ===" > "$ENGINE_LOG"

# 1. HATA DÜZELTMESİ: Çekirdek Kernel UUID Yedeği
if which dbus-uuidgen >/dev/null 2>&1; then
    dbus-uuidgen > "${ETC_MOCK_DIR}/machine-id"
else
    cat /proc/sys/kernel/random/uuid > "${ETC_MOCK_DIR}/machine-id"
fi

cat << 'OS_EOF' > "${ETC_MOCK_DIR}/os-release"
NAME="SafeBox OS"
VERSION="1.7.5 (Hardened Sandbox)"
ID=safebox
ID_LIKE=debian
PRETTY_NAME="SafeBox Hardened Workspace"
OS_EOF

# 2. Sanal Bellek (/proc/meminfo)
TOTAL_KB=$((RAM_GB * 1024 * 1024))
FREE_KB=$((TOTAL_KB * 80 / 100))
AVAIL_KB=$((TOTAL_KB * 75 / 100))

cat << MEM_EOF > "${PROC_MOCK_DIR}/meminfo"
MemTotal:       ${TOTAL_KB} kB
MemFree:        ${FREE_KB} kB
MemAvailable:   ${AVAIL_KB} kB
Buffers:           32000 kB
Cached:           120000 kB
SwapCached:            0 kB
Active:           100000 kB
Inactive:          40000 kB
SwapTotal:             0 kB
SwapFree:              0 kB
MEM_EOF

# 3. HATA DÜZELTMESİ: Gerçek Host Çekirdek Sayısını Aşmayı Engelle (Taskset Crash Fix)
HOST_CORES=$(nproc 2>/dev/null || echo 4)
if [ "$CPU_CORES" -gt "$HOST_CORES" ]; then
    CPU_CORES=$HOST_CORES
fi

rm -f "${PROC_MOCK_DIR}/cpuinfo" "${PROC_MOCK_DIR}/stat"
echo "cpu  2000 0 2000 20000 0 0 0 0 0 0" > "${PROC_MOCK_DIR}/stat"

for ((i=0; i<CPU_CORES; i++)); do
    cat << CPU_EOF >> "${PROC_MOCK_DIR}/cpuinfo"
processor	: $i
vendor_id	: GenuineIntel
cpu family	: 6
model_name	: SafeBox Isolated Virtual Core
stepping	: 1
cpu MHz		: 2500.000
cache size	: 18432 KB
physical id	: 0
siblings	: $CPU_CORES
core id		: $i
cpu cores	: $CPU_CORES
flags		: fpu vme de pse tsc msr pae mce cx8 apic sep mtrr pge mca cmov pat pse36 clflush mmx fxsr sse sse2 ht syscall nx lm constant_tsc rep_good nopl xtopology cpuid pni pclmulqdq ssse3 fma cx16 sse4_1 sse4_2 movbe popcnt aes xsave avx f16c rdrand hypervisor

CPU_EOF
    echo "cpu$i 1000 0 1000 10000 0 0 0 0 0 0" >> "${PROC_MOCK_DIR}/stat"
done

MAX_CORE=$((CPU_CORES - 1))
if [ "$MAX_CORE" -lt 0 ]; then MAX_CORE=0; fi
echo "0-${MAX_CORE}" > "${SYS_MOCK_DIR}/devices/system/cpu/online"
CPU_AFFINITY="0-${MAX_CORE}"

# 4. Rootless Xorg sanal ekranı
#
# Xephyr, Cinnamon'un monitor/RandR altyapısıyla uyumlu çalışmadığı
# için kullanılmaz. Aynı kullanıcı altında rootless Xorg + dummy
# driver ile gerçek bir RandR monitor nesnesi oluşturulur.

TARGET_DISP=""
for d in $(seq 10 99); do
    if [ ! -e "/tmp/.X11-unix/X$d" ] && [ ! -e "/tmp/.X$d-lock" ]; then
        TARGET_DISP=":$d"
        break
    fi
done

if [ -z "$TARGET_DISP" ]; then
    echo "[HATA] Boş X11 ekranı bulunamadı!" >> "$ENGINE_LOG"
    exit 101
fi

XORG_CONFIG="/usr/share/safebox/xorg/safebox-dummy.conf"

if [ ! -f "$XORG_CONFIG" ]; then
    echo "[HATA] Xorg yapılandırması bulunamadı: $XORG_CONFIG" >> "$ENGINE_LOG"
    exit 102
fi

/usr/lib/xorg/Xorg "$TARGET_DISP" \
    -config "$XORG_CONFIG" \
    -noreset \
    -nolisten tcp \
    -ac \
    -keeptty >> "$ENGINE_LOG" 2>&1 &

XORG_PID=$!

cleanup() {
    echo "[BİLGİ] Oturum kapatılıyor..." >> "$ENGINE_LOG"
    kill "$XORG_PID" 2>/dev/null || true
    wait "$XORG_PID" 2>/dev/null || true
    rm -f "$DISPLAY_FILE"
    echo "=== [$(date '+%Y-%m-%d %H:%M:%S')] Oturum Kapatıldı ===" >> "$ENGINE_LOG"
}
trap cleanup EXIT INT TERM

XORG_READY=0

for i in {1..30}; do
    if [ -S "/tmp/.X11-unix/X${TARGET_DISP#:}" ]; then
        XORG_READY=1
        break
    fi

    if ! kill -0 "$XORG_PID" 2>/dev/null; then
        break
    fi

    sleep 0.2
done

if [ "$XORG_READY" -eq 0 ]; then
    echo "[HATA] Rootless Xorg başlatılamadı!" >> "$ENGINE_LOG"
    tail -40 "$ENGINE_LOG" >> "$ENGINE_LOG" 2>/dev/null || true
    exit 103
printf '%s\n' "$TARGET_DISP" > "$DISPLAY_FILE"
chmod 600 "$DISPLAY_FILE"

fi

# 1366x768 modelini Xorg'a ekle.
# Dummy driver bazı sistemlerde bu modu config'ten otomatik üretmez.
if ! DISPLAY="$TARGET_DISP" xrandr --query 2>/dev/null |
        grep -q '1366x768_60.00'; then

    DISPLAY="$TARGET_DISP" xrandr --newmode "1366x768_60.00" \
        85.50 1366 1440 1576 1780 768 771 775 798 \
        -hsync +vsync >> "$ENGINE_LOG" 2>&1 || true

    DISPLAY="$TARGET_DISP" xrandr \
        --addmode DUMMY0 "1366x768_60.00" >> "$ENGINE_LOG" 2>&1 || true
fi

PRIMARY_OUTPUT="$(
    DISPLAY="$TARGET_DISP" xrandr --query 2>/dev/null |
    awk '/ connected/{print $1; exit}'
)"

if [ -n "$PRIMARY_OUTPUT" ]; then
    if DISPLAY="$TARGET_DISP" xrandr \
        --output "$PRIMARY_OUTPUT" \
        --mode "1366x768_60.00" \
        --primary >> "$ENGINE_LOG" 2>&1; then

        echo "[OK] Xorg primary output: $PRIMARY_OUTPUT (1366x768)" >> "$ENGINE_LOG"
    else
        echo "[UYARI] 1366x768 ayarlanamadı, mevcut mod korunuyor." >> "$ENGINE_LOG"
    fi
else
    echo "[HATA] Xorg connected output bulunamadı." >> "$ENGINE_LOG"
    exit 104
fi

# 5. HATA DÜZELTMESİ: --dev /dev Geri Getirildi (Terminal PTS çökmelerini önler)
ROOTFS="/var/lib/safebox/rootfs"

if [ ! -x "${ROOTFS}/bin/bash" ]; then
    echo "[HATA] SafeBox rootfs bulunamadı veya eksik: ${ROOTFS}" >> "$ENGINE_LOG"
    exit 105
fi

BWRAP_ARGS=(
    --unshare-all
    --uid 1000
    --gid 1000
    --hostname safebox-sandbox

    # Ayrı guest rootfs
    --bind "$ROOTFS" /

    # Guest pseudo filesystems
    --dev /dev
    --proc /proc
    --tmpfs /sys
    --tmpfs /tmp
    --tmpfs /run
    --tmpfs /var

    # Guest runtime
    --dir /run/user/1000
    --setenv XDG_RUNTIME_DIR /run/user/1000

    # Guest home
    --tmpfs /home
    --dir /home/safebox
    --dir /home/safebox/.config
    --dir /home/safebox/.cache
    --dir /home/safebox/.local
    --dir /home/safebox/.local/share
    --dir /home/safebox/.local/bin

    --setenv HOME /home/safebox
    --setenv USER safebox
    --setenv LOGNAME safebox
    --setenv DISPLAY "$TARGET_DISP"
    --setenv PATH "/home/safebox/.local/bin:/usr/local/bin:/usr/bin:/bin"

    # Uygulama menüsü için yalnızca SafeBox veri kökü
    --setenv XDG_DATA_DIRS "/opt/share:/usr/local/share"

    # Kimlik izolasyonu
    --ro-bind "${ETC_MOCK_DIR}/machine-id" /etc/machine-id
    --ro-bind "${ETC_MOCK_DIR}/os-release" /usr/lib/os-release
    --ro-bind /usr/share/safebox/guest-etc/passwd /etc/passwd
    --ro-bind /usr/share/safebox/guest-etc/group /etc/group
    --ro-bind /usr/share/safebox/guest-etc/shadow /etc/shadow
    --ro-bind /usr/share/safebox/guest-etc/nsswitch.conf /etc/nsswitch.conf
    --ro-bind /usr/share/safebox/guest-etc/hostname /etc/hostname
    --ro-bind /usr/share/safebox/guest-etc/hosts /etc/hosts

    # SafeBox runtime
    --ro-bind /usr/share/safebox/guest-init /usr/share/safebox/guest-init
    --ro-bind /usr/share/safebox/guest-apps /usr/share/safebox/guest-apps
    --ro-bind /usr/share/safebox/guest-config /usr/share/safebox/guest-config
    --ro-bind /usr/share/safebox/safebox-guest-blocker /usr/share/safebox/safebox-guest-blocker
    --ro-bind /usr/share/safebox/xorg /usr/share/safebox/xorg

    # Mock hardware
    --ro-bind "${PROC_MOCK_DIR}/meminfo" /proc/meminfo
    --ro-bind "${PROC_MOCK_DIR}/cpuinfo" /proc/cpuinfo
    --ro-bind "${PROC_MOCK_DIR}/stat" /proc/stat

    --dir /sys/devices
    --dir /sys/devices/system
    --dir /sys/devices/system/cpu
    --ro-bind "${SYS_MOCK_DIR}/devices/system/cpu/online" /sys/devices/system/cpu/online

    # Yalnızca seçilmiş SafeBox desktop launcher'ları
    --dir /opt
    --dir /opt/share
    --dir /opt/share/applications

    # Guest filesystem'deki bütün uygulama listesini gizle.
    --tmpfs /usr/share/applications

    --ro-bind /usr/share/safebox/guest-apps/browser.desktop \
        /usr/share/applications/browser.desktop
    --ro-bind /usr/share/safebox/guest-apps/editor.desktop \
        /usr/share/applications/editor.desktop
    --ro-bind /usr/share/safebox/guest-apps/home.desktop \
        /usr/share/applications/home.desktop
    --ro-bind /usr/share/safebox/guest-apps/share.desktop \
        /usr/share/applications/share.desktop
    --ro-bind /usr/share/safebox/guest-apps/terminal.desktop \
        /usr/share/applications/terminal.desktop

    --ro-bind /usr/share/safebox/browser-run         /usr/share/safebox/browser-run
    --ro-bind /usr/share/safebox/rofi         /usr/share/safebox/rofi
    --ro-bind /usr/share/safebox/guest-apps/monitor.desktop \
        /usr/share/applications/monitor.desktop
    --ro-bind /usr/share/safebox/guest-apps/menu.desktop \
        /usr/share/applications/menu.desktop

    --ro-bind /usr/share/safebox/guest-apps \
        /opt/share/applications

    --ro-bind /usr/share/safebox/safebox-guest-blocker \
        /home/safebox/.local/bin/safebox

    # X11
    --bind "/tmp/.X11-unix/X${TARGET_DISP#:}" \
        "/tmp/.X11-unix/X${TARGET_DISP#:}"

    --die-with-parent
    --new-session
)

# Kontrollü /dev/dri Düğümleri
if [ -e /dev/dri/renderD128 ]; then BWRAP_ARGS+=(--dev-bind /dev/dri/renderD128 /dev/dri/renderD128); fi
if [ -e /dev/dri/card0 ]; then BWRAP_ARGS+=(--dev-bind /dev/dri/card0 /dev/dri/card0); fi

# Kontrollü NVIDIA Düğümleri
for nv_node in /dev/nvidia0 /dev/nvidiactl /dev/nvidia-modeset /dev/nvidia-uvm; do
    if [ -e "$nv_node" ]; then BWRAP_ARGS+=(--dev-bind "$nv_node" "$nv_node"); fi
done

# Ağ
if [ "$NET" = "1" ]; then
    BWRAP_ARGS+=(--share-net)
    if [ -d /run/systemd/resolve ]; then BWRAP_ARGS+=(--ro-bind /run/systemd/resolve /run/systemd/resolve); fi
    if [ -f /etc/resolv.conf ]; then BWRAP_ARGS+=(--ro-bind-try /etc/resolv.conf /etc/resolv.conf); fi
fi

# Ses
if [ "$AUDIO" = "1" ]; then
    if [ -S "${XDG_RUNTIME_DIR}/pulse/native" ]; then
        BWRAP_ARGS+=(--bind "${XDG_RUNTIME_DIR}/pulse/native" "/run/user/1000/pulse/native" --setenv PULSE_SERVER "unix:/run/user/1000/pulse/native")
    elif [ -S "${XDG_RUNTIME_DIR}/pipewire-0" ]; then
        BWRAP_ARGS+=(--bind "${XDG_RUNTIME_DIR}/pipewire-0" "/run/user/1000/pipewire-0")
    fi
fi

# Paylaşım Klasörü
if [ "$SHARE_FOLDER" = "1" ]; then
    mkdir -p "${HOME}/SafeBox-Paylasim"
    BWRAP_ARGS+=(--bind "${HOME}/SafeBox-Paylasim" "/home/safebox/Paylasim")
fi

# X11 Socket
BWRAP_ARGS+=(--bind "/tmp/.X11-unix/X${TARGET_DISP#:}" "/tmp/.X11-unix/X${TARGET_DISP#:}")


# 6. cgroup v2 Gerçek Sınırlandırma ile Başlat
CPU_QUOTA_VAL=$((CPU_CORES * 100))
SYSTEMD_ARGS=(
    --user
    --scope
    -p "MemoryMax=${RAM_GB}G"
    -p "CPUQuota=${CPU_QUOTA_VAL}%"
)

if which systemd-run >/dev/null 2>&1; then
    taskset -c "$CPU_AFFINITY" systemd-run "${SYSTEMD_ARGS[@]}" bwrap "${BWRAP_ARGS[@]}" dbus-run-session -- /usr/share/safebox/guest-init >> "$ENGINE_LOG" 2>&1
else
    taskset -c "$CPU_AFFINITY" bwrap "${BWRAP_ARGS[@]}" dbus-run-session -- /usr/share/safebox/guest-init >> "$ENGINE_LOG" 2>&1
fi
