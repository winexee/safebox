#!/bin/bash
if [ -n "$SNAP" ]; then
    export GSETTINGS_SCHEMA_DIR="$SNAP/usr/share/glib-2.0/schemas:$GSETTINGS_SCHEMA_DIR"
    export NO_AT_BRIDGE=1
    export GDK_PIXBUF_MODULE_FILE=""
    exec python3 "$SNAP/usr/share/safebox/safebox_gui.py" "$@" 2>/dev/null
else
    export NO_AT_BRIDGE=1
    exec python3 "/usr/share/safebox/safebox_gui.py" "$@"
fi
