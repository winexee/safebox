#!/usr/bin/env bash
set -euo pipefail

export HOME=/home/safebox
export USER=safebox
export LOGNAME=safebox

export XDG_CONFIG_HOME="$HOME/.config"
export XDG_CACHE_HOME="$HOME/.cache"
export XDG_DATA_HOME="$HOME/.local/share"
export XDG_DATA_DIRS="/opt:/usr/local/share:/usr/share"

export XDG_SESSION_TYPE=x11
export XDG_CURRENT_DESKTOP=X-Cinnamon
export XDG_SESSION_DESKTOP=cinnamon
export DESKTOP_SESSION=cinnamon

# Host Cinnamon/ICE oturum bilgisini guest'e taşımama.
unset SESSION_MANAGER
unset DBUS_SESSION_BUS_ADDRESS


# Cinnamon-session için private ICE authority.
export ICEAUTHORITY="$HOME/.ICEauthority"
touch "$ICEAUTHORITY"
chmod 600 "$ICEAUTHORITY"


export GIO_USE_VFS=local
export GVFS_DISABLE_FUSE=1

# Önce stabil Cinnamon varsayılanlarıyla başlayalım.
# Tema özelleştirmesini session çalıştıktan sonra ayrı ele alacağız.
export GTK_THEME="Yaru-dark"

mkdir -p \
    "$HOME/Desktop" \
    "$HOME/Masaüstü" \
    "$HOME/Belgeler" \
    "$HOME/Documents" \
    "$HOME/İndirilenler" \
    "$HOME/Downloads" \
    "$HOME/Resimler" \
    "$HOME/Pictures" \
    "$HOME/.config/gtk-3.0" \
    "$HOME/.config/gtk-4.0" \
    "$HOME/.config/cinnamon" \
    "$HOME/.cache" \
    "$HOME/.local/share"

cat > "$HOME/.config/gtk-3.0/settings.ini" <<'GTK3_EOF'
[Settings]
gtk-theme-name=Yaru-dark
gtk-icon-theme-name=Yaru
gtk-font-name=Ubuntu 10
gtk-application-prefer-dark-theme=1
GTK3_EOF

cat > "$HOME/.config/gtk-4.0/settings.ini" <<'GTK4_EOF'
[Settings]
gtk-theme-name=Yaru-dark
gtk-icon-theme-name=Yaru
gtk-font-name=Ubuntu 10
gtk-application-prefer-dark-theme=1
GTK4_EOF

rm -f "$HOME/Desktop/"*.desktop "$HOME/Masaüstü/"*.desktop 2>/dev/null || true

for app in browser home share terminal editor monitor; do
    if [ -f "/opt/applications/${app}.desktop" ]; then
        cp "/opt/applications/${app}.desktop" "$HOME/Desktop/" 2>/dev/null || true
        cp "/opt/applications/${app}.desktop" "$HOME/Masaüstü/" 2>/dev/null || true
    fi
done

chmod +x "$HOME/Desktop/"*.desktop "$HOME/Masaüstü/"*.desktop 2>/dev/null || true

# Cinnamon'u doğrudan özel session D-Bus altında başlat.
# cinnamon-session kullanılmaz; test edilen rootless-Xorg yoludur.

unset SESSION_MANAGER
unset DBUS_SESSION_BUS_ADDRESS

exec dbus-run-session -- cinnamon --sm-disable
