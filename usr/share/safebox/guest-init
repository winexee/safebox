#!/usr/bin/env bash
export HOME=/home/safebox
export USER=safebox
export LOGNAME=safebox

export XDG_DATA_DIRS=/usr/local/share:/usr/share
export XDG_CURRENT_DESKTOP=X-Cinnamon
export DESKTOP_SESSION=cinnamon
export LIBGL_ALWAYS_SOFTWARE=1
export GIO_USE_VFS=local
export GVFS_DISABLE_FUSE=1

mkdir -p /home/safebox/Desktop /home/safebox/Downloads /home/safebox/Documents /home/safebox/Paylasim

# Masaüstü Simgeleri
for app in browser home share terminal editor; do
    app_file="/tmp/guest-apps/${app}.desktop"
    if [ -f "$app_file" ]; then
        cp "$app_file" /home/safebox/Desktop/ 2>/dev/null && chmod +x /home/safebox/Desktop/${app}.desktop 2>/dev/null || true
    fi
done

# GTK Tema ve İkon Ayarları (Görünümün düzelmesi için)
mkdir -p /home/safebox/.config/gtk-3.0
cat > /home/safebox/.config/gtk-3.0/settings.ini << 'EOF'
[Settings]
gtk-theme-name=Adwaita
gtk-icon-theme-name=Adwaita
gtk-font-name=Sans 10
gtk-application-prefer-dark-theme=1
EOF

cat > /home/safebox/.gtkrc-2.0 << 'EOF'
gtk-theme-name="Adwaita"
gtk-icon-theme-name="Adwaita"
gtk-font-name="Sans 10"
EOF

export CINNAMON_SOFTWARE_RENDERING=1
export LIBGL_ALWAYS_SOFTWARE=1


# Masaüstü ve Tema ayarları (GSettings)
dconf write /org/cinnamon/desktop/background/picture-uri "'none'" || true
dconf write /org/cinnamon/desktop/background/primary-color "'#2b2b2b'" || true
dconf write /org/cinnamon/desktop/background/color-shading-type "'solid'" || true
dconf write /org/cinnamon/desktop/interface/cursor-theme "'DMZ-White'" || true
dconf write /org/cinnamon/desktop/interface/gtk-theme "'Adwaita'" || true
dconf write /org/cinnamon/desktop/interface/icon-theme "'Adwaita'" || true


# Host izolasyonunu sağlamak için sahte (mock) bir System DBus başlat (Cinnamon çökmesini engeller)
mkdir -p /run/dbus
dbus-daemon --session --address=unix:path=/run/dbus/system_bus_socket --nopidfile --syslog-only &
\n# Temel masaüstü bileşenlerini başlat (Cinnamon'un DBus oturumu ile başlaması gerekir)

exec dbus-run-session -- cinnamon-session
