#!/usr/bin/env bash
export HOME=/home/safebox
export USER=safebox
export LOGNAME=safebox

export XDG_DATA_DIRS=/usr/share/cinnamon:/usr/share/gnome:/usr/local/share/:/usr/share/
export XDG_CURRENT_DESKTOP=X-Cinnamon
export XDG_SESSION_DESKTOP=cinnamon
export DESKTOP_SESSION=cinnamon
export CINNAMON_2D=1
export LIBGL_ALWAYS_SOFTWARE=1
export GIO_USE_VFS=local
export GVFS_DISABLE_FUSE=1

mkdir -p /home/safebox/{Desktop,Masaüstü,İndirilenler,Belgeler,Paylasim}

# Masaüstü Simgeleri
echo "[BİLGİ] Masaüstü simgeleri kurulu..."
for app in browser home share terminal editor monitor; do
    app_file="/usr/share/safebox/guest-apps/${app}.desktop"
    if [ -f "$app_file" ]; then
        if cp "$app_file" /home/safebox/Desktop/ 2>/dev/null; then
            chmod +x /home/safebox/Desktop/${app}.desktop 2>/dev/null || true
        else
            echo "[UYARI] ${app}.desktop Desktop'a kopyalanamadı" >&2
        fi
        
        if cp "$app_file" /home/safebox/Masaüstü/ 2>/dev/null; then
            chmod +x /home/safebox/Masaüstü/${app}.desktop 2>/dev/null || true
        else
            echo "[UYARI] ${app}.desktop Masaüstü'ne kopyalanamadı" >&2
        fi
    else
        echo "[UYARI] Masaüstü simgesi bulunamadı: $app_file" >&2
    fi
done

echo "[BİLGİ] Masaüstü hazırlandı"

# Cinnamon Masaüstünü 2D Modunda Güvenle Başlat
if which cinnamon2d >/dev/null 2>&1; then
    exec cinnamon2d
elif which cinnamon-session >/dev/null 2>&1; then
    exec cinnamon-session --session=cinnamon2d
else
    # Fallback
    xfwm4 &
    pcmanfm --desktop &
    tint2 &
    wait
fi
