#!/usr/bin/env bash
# SafeBox Enterprise Hardened Engine (v1.7.5 - Critical Fixes)
set -euo pipefail

RAM_GB="${1:-4}"
CPU_CORES="${2:-4}"
RESOLUTION="${3:-1366x768}"
SHARE_FOLDER="${4:-1}"
CLIPBOARD="${5:-1}"
AUDIO="${6:-1}"
NET="${7:-1}"

# ✅ FIX #1: XDG_RUNTIME_DIR aynı başlangıçta tanımla
if [ -z "${XDG_RUNTIME_DIR:-}" ]; then
    XDG_RUNTIME_DIR="/run/user/$(id -u)"
fi
export XDG_RUNTIME_DIR

LOG_DIR="${HOME}/.local/share/safebox"
PROC_MOCK_DIR="${LOG_DIR}/mock_proc"
SYS_MOCK_DIR="${LOG_DIR}/mock_sys"
ETC_MOCK_DIR="${LOG_DIR}/mock_etc"
ENGINE_LOG="${LOG_DIR}/safebox-engine.log"

# ✅ FIX #2: Klasör oluştur ve izinleri kontrol et
mkdir -p "$LOG_DIR" "$PROC_MOCK_DIR" "$SYS_MOCK_DIR/devices/system/cpu" "$ETC_MOCK_DIR" 2>/dev/null || {
    echo "[HATA] Log dizini oluşturulamadı: $LOG_DIR" >&2
    exit 201
}

# ✅ FIX #3: Log dosyasını chmod 600 yap (güvenlik)
touch "$ENGINE_LOG"
chmod 600 "$ENGINE_LOG"

echo "=== [$(date '+%Y-%m-%d %H:%M:%S')] SafeBox Engine v1.7.5 Başlatılıyor ===" >> "$ENGINE_LOG"

# 1. Kernel UUID Yedeği
if which dbus-uuidgen >/dev/null 2>&1; then
    dbus-uuidgen > "${ETC_MOCK_DIR}/machine-id"
else
    if [ -f /proc/sys/kernel/random/uuid ]; then
        cat /proc/sys/kernel/random/uuid > "${ETC_MOCK_DIR}/machine-id"
    else
        # ✅ FIX #4: UUID fallback
        echo "$(date +%s)-$RANDOM-$RANDOM" > "${ETC_MOCK_DIR}/machine-id"
    fi
fi
chmod 600 "${ETC_MOCK_DIR}/machine-id"

cat << 'OS_EOF' > "${ETC_MOCK_DIR}/os-release"
NAME="SafeBox OS"
VERSION="1.7.5 (Hardened Sandbox)"
ID=safebox
ID_LIKE=debian
PRETTY_NAME="SafeBox Hardened Workspace"
OS_EOF

# 2. Sanal Bellek (/proc/meminfo)
TOTAL_KB=$((RAM_GB * 1024 * 1024))
FREE_KB=$((TOTAL_KB * 80 / 100))
AVAIL_KB=$((TOTAL_KB * 75 / 100))

cat << MEM_EOF > "${PROC_MOCK_DIR}/meminfo"
MemTotal:       ${TOTAL_KB} kB
MemFree:        ${FREE_KB} kB
MemAvailable:   ${AVAIL_KB} kB
Buffers:           32000 kB
Cached:           120000 kB
SwapCached:            0 kB
Active:           100000 kB
Inactive:          40000 kB
SwapTotal:             0 kB
SwapFree:              0 kB
MEM_EOF

# 3. ✅ FIX #5: CPU cores validation (host > requested check)
HOST_CORES=$(nproc 2>/dev/null || echo 4)
if [ "$CPU_CORES" -gt "$HOST_CORES" ]; then
    echo "[UYARI] CPU çekirdeği $CPU_CORES > host çekirdeği $HOST_CORES, düşürülüyor..." >> "$ENGINE_LOG"
    CPU_CORES=$HOST_CORES
fi

if [ "$CPU_CORES" -lt 1 ]; then
    CPU_CORES=1
fi

# CPU info dosyası
rm -f "${PROC_MOCK_DIR}/cpuinfo" "${PROC_MOCK_DIR}/stat"
echo "cpu  2000 0 2000 20000 0 0 0 0 0 0" > "${PROC_MOCK_DIR}/stat"

for ((i=0; i<CPU_CORES; i++)); do
    cat << CPU_EOF >> "${PROC_MOCK_DIR}/cpuinfo"
processor	: $i
vendor_id	: GenuineIntel
cpu family	: 6
model_name	: SafeBox Isolated Virtual Core
stepping	: 1
cpu MHz		: 2500.000
cache size	: 18432 KB
physical id	: 0
siblings	: $CPU_CORES
core id		: $i
cpu cores	: $CPU_CORES
flags		: fpu vme de pse tsc msr pae mce cx8 apic sep mtrr pge mca cmov pat pse36 clflush mmx fxsr sse sse2 ht syscall nx lm constant_tsc rep_good nopl xtopology cpuid pni pclmulqdq ssse3 fma cx16 sse42 x2apic movbe popcnt tsc_deadline_timer aes xsave avx f16c rdrand lahf_lm cmp_legacy svm extapic cr8_legacy abm sse4a misalignsse 3dnowprefetch osvw ibs xop skinit wdt lwp fma4 tce nodeid_msr tbm topoext perfctr_core

CPU_EOF
    echo "cpu$i 1000 0 1000 10000 0 0 0 0 0 0" >> "${PROC_MOCK_DIR}/stat"
done

MAX_CORE=$((CPU_CORES - 1))
if [ "$MAX_CORE" -lt 0 ]; then MAX_CORE=0; fi
echo "0-${MAX_CORE}" > "${SYS_MOCK_DIR}/devices/system/cpu/online"
CPU_AFFINITY="0-${MAX_CORE}"

# 4. ✅ FIX #6: Display bulma (sıralı, robust)
TARGET_DISP=""
for d in {10..99}; do
    if [ ! -e "/tmp/.X11-unix/X$d" ] && [ ! -e "/tmp/.X${d}-lock" ]; then
        TARGET_DISP=":$d"
        break
    fi
done

if [ -z "$TARGET_DISP" ]; then
    echo "[HATA] Boş X11 ekranı bulunamadı (10-99 aralığında)" >> "$ENGINE_LOG"
    exit 101
fi

echo "[INFO] X11 Display seçildi: $TARGET_DISP" >> "$ENGINE_LOG"

# Xephyr başlatma
Xephyr "$TARGET_DISP" -screen "$RESOLUTION" -title "SafeBox Secure Workspace ($TARGET_DISP)" -resizeable >> "$ENGINE_LOG" 2>&1 &
XEPHYR_PID=$!
echo "[INFO] Xephyr başlatıldı (PID: $XEPHYR_PID)" >> "$ENGINE_LOG"

cleanup() {
    local exit_code=$?
    echo "[BİLGİ] Cleanup başlatılıyor (exit code: $exit_code)..." >> "$ENGINE_LOG"
    
    # ✅ FIX #7: Xephyr graceful kill
    if [ -n "$XEPHYR_PID" ] && kill -0 "$XEPHYR_PID" 2>/dev/null; then
        kill "$XEPHYR_PID" 2>/dev/null || true
        sleep 1
        kill -9 "$XEPHYR_PID" 2>/dev/null || true
    fi
    
    # ✅ FIX #8: X11 socket cleanup
    rm -f "/tmp/.X11-unix/X${TARGET_DISP#:}" 2>/dev/null || true
    rm -f "/tmp/.X${TARGET_DISP#:}-lock" 2>/dev/null || true
    
    echo "=== [$(date '+%Y-%m-%d %H:%M:%S')] Oturum Kapatıldı (kod: $exit_code) ===" >> "$ENGINE_LOG"
    exit "$exit_code"
}
trap cleanup EXIT INT TERM

# ✅ FIX #9: Xephyr ready polling (robust timeout)
XEPHYR_READY=0
TIMEOUT_COUNT=50  # 50 * 0.2s = 10 saniye
for ((i=0; i<TIMEOUT_COUNT; i++)); do
    if [ -e "/tmp/.X11-unix/X${TARGET_DISP#:}" ]; then
        XEPHYR_READY=1
        echo "[INFO] Xephyr hazır (${i} polling)" >> "$ENGINE_LOG"
        break
    fi
    sleep 0.2
done

if [ "$XEPHYR_READY" -eq 0 ]; then
    echo "[HATA] Xephyr başlatılamadı ($TIMEOUT_COUNT deneme)" >> "$ENGINE_LOG"
    exit 102
fi

# 5. Bubblewrap argümanları
BWRAP_ARGS=(
    --unshare-all
    --uid 1000
    --gid 1000
    --hostname safebox-sandbox
    --ro-bind /usr /usr
    --ro-bind /lib /lib
    --ro-bind /lib64 /lib64
    --ro-bind /bin /bin
    --ro-bind /sbin /sbin
    --ro-bind /etc /etc
    --ro-bind "${ETC_MOCK_DIR}/machine-id" /etc/machine-id
    --ro-bind "${ETC_MOCK_DIR}/os-release" /etc/os-release
    --dev /dev
    --proc /proc
    --ro-bind "${PROC_MOCK_DIR}/meminfo" /proc/meminfo
    --ro-bind "${PROC_MOCK_DIR}/cpuinfo" /proc/cpuinfo
    --ro-bind "${PROC_MOCK_DIR}/stat" /proc/stat
    --tmpfs /sys
    --ro-bind "${SYS_MOCK_DIR}/devices/system/cpu/online" /sys/devices/system/cpu/online
    --tmpfs /tmp
    --tmpfs /var
    --tmpfs /run
    --dir /run/user/1000
    --setenv XDG_RUNTIME_DIR /run/user/1000
    --tmpfs /home
    --dir /home/safebox
    --dir /home/safebox/.local/bin
    --setenv HOME /home/safebox
    --setenv USER safebox
    --setenv LOGNAME safebox
    --setenv DISPLAY "$TARGET_DISP"
    --setenv PATH "/home/safebox/.local/bin:/usr/local/bin:/usr/bin:/bin"
    --tmpfs /usr/share/applications
    --die-with-parent
    --new-session
)

# ✅ FIX #10: Ses kontrollü bağlama
if [ "$AUDIO" = "1" ]; then
    if [ -S "${XDG_RUNTIME_DIR}/pulse/native" ]; then
        BWRAP_ARGS+=(
            --bind "${XDG_RUNTIME_DIR}/pulse/native" "/run/user/1000/pulse/native"
            --setenv PULSE_SERVER "unix:/run/user/1000/pulse/native"
        )
        echo "[SES] PulseAudio bağlandı" >> "$ENGINE_LOG"
    elif [ -S "${XDG_RUNTIME_DIR}/pipewire-0" ]; then
        BWRAP_ARGS+=(--bind "${XDG_RUNTIME_DIR}/pipewire-0" "/run/user/1000/pipewire-0")
        echo "[SES] PipeWire bağlandı" >> "$ENGINE_LOG"
    else
        echo "[UYARI] Ses desteği bulunamadı" >> "$ENGINE_LOG"
    fi
fi

# ✅ FIX #11: Paylaşılan klasör
if [ "$SHARE_FOLDER" = "1" ]; then
    SHARE_PATH="${HOME}/SafeBox-Paylasim"
    mkdir -p "$SHARE_PATH" 2>/dev/null || {
        echo "[UYARI] Paylaşım klasörü oluşturulamadı" >> "$ENGINE_LOG"
    }
    BWRAP_ARGS+=(--bind "$SHARE_PATH" "/home/safebox/Paylasim")
fi

# X11 Socket
BWRAP_ARGS+=(--bind "/tmp/.X11-unix/X${TARGET_DISP#:}" "/tmp/.X11-unix/X${TARGET_DISP#:}")

# 6. ✅ FIX #12: cgroup v2 sınırlandırma
CPU_QUOTA_VAL=$((CPU_CORES * 100))
SYSTEMD_ARGS=(
    --user
    --scope
    -p "MemoryMax=${RAM_GB}G"
    -p "CPUQuota=${CPU_QUOTA_VAL}%"
)

echo "[INFO] Başlatılıyor: $CPU_CORES CPU, ${RAM_GB}GB RAM, $RESOLUTION" >> "$ENGINE_LOG"

# ✅ FIX #13: systemd-run fallback
if which systemd-run >/dev/null 2>&1; then
    taskset -c "$CPU_AFFINITY" systemd-run "${SYSTEMD_ARGS[@]}" bwrap "${BWRAP_ARGS[@]}" dbus-run-session -- /usr/share/safebox/guest-init >> "$ENGINE_LOG" 2>&1 || true
else
    taskset -c "$CPU_AFFINITY" bwrap "${BWRAP_ARGS[@]}" dbus-run-session -- /usr/share/safebox/guest-init >> "$ENGINE_LOG" 2>&1 || true
fi

exit 0
