#!/usr/bin/env bash
# SafeBox Robust Engine & Virtual Machine Runtime Core (v1.4.4)
set -e

RAM_GB="${1:-4}"
CPU_CORES="${2:-4}"
RESOLUTION="${3:-1366x768}"
SHARE_FOLDER="${4:-1}"
CLIPBOARD="${5:-1}"
AUDIO="${6:-1}"
NET="${7:-1}"

LOG_DIR="${HOME}/.local/share/safebox"
ENGINE_LOG="${LOG_DIR}/safebox-engine.log"
mkdir -p "$LOG_DIR"

echo "=== [$(date '+%Y-%m-%d %H:%M:%S')] SafeBox Sanal Makine Başlatılıyor ===" > "$ENGINE_LOG"
echo "Yapılandırma: RAM=${RAM_GB}GB, CPU=${CPU_CORES}, Çözünürlük=${RESOLUTION}, Ağ=${NET}, Ses=${AUDIO}" >> "$ENGINE_LOG"

# 1. Boş bir DISPLAY ekran numarası bul (:10 ile :99 arası)
TARGET_DISP=""
for d in $(seq 10 99); do
    if [ ! -e "/tmp/.X11-unix/X$d" ] && [ ! -e "/tmp/.X$d-lock" ]; then
        TARGET_DISP=":$d"
        break
    fi
done

if [ -z "$TARGET_DISP" ]; then
    echo "[HATA] Boş bir sanal ekran (DISPLAY) bulunamadı!" | tee -a "$ENGINE_LOG"
    exit 101
fi
echo "[BİLGİ] Sanal X11 Display atandı: $TARGET_DISP" >> "$ENGINE_LOG"

# 2. Xephyr Sanal Ekranını Başlat
echo "[BİLGİ] Xephyr penceresi başlatılıyor (${RESOLUTION})..." >> "$ENGINE_LOG"
Xephyr "$TARGET_DISP" -screen "$RESOLUTION" -ac -title "SafeBox Virtual Desktop ($TARGET_DISP)" -resizeable >> "$ENGINE_LOG" 2>&1 &
XEPHYR_PID=$!

cleanup() {
    echo "[BİLGİ] Oturum sonlandırılıyor, süreçler temizleniyor..." >> "$ENGINE_LOG"
    kill -9 "$XEPHYR_PID" 2>/dev/null || true
    echo "=== [$(date '+%Y-%m-%d %H:%M:%S')] Sanal Makine Güvenle Kapatıldı ===" >> "$ENGINE_LOG"
}
trap cleanup EXIT INT TERM

# Xephyr hazır olana kadar bekle
for i in {1..25}; do
    if [ -e "/tmp/.X11-unix/X${TARGET_DISP#:}" ]; then
        break
    fi
    sleep 0.2
done

# 3. Bubblewrap Parametrelerini İnşa Et (Kusursuz /home tmpfs Mimarisi)
BWRAP_ARGS=(
    --ro-bind / /
    --dev /dev
    --proc /proc
    --tmpfs /tmp
    --tmpfs /var
    --tmpfs /run
    --dir /run/user/1000
    --setenv XDG_RUNTIME_DIR /run/user/1000
    --tmpfs /home
    --dir /home/safebox
    --setenv HOME /home/safebox
    --setenv USER safebox
    --setenv LOGNAME safebox
    --setenv DISPLAY "$TARGET_DISP"
    --unshare-all
    --die-with-parent
    --new-session
    --ro-bind /usr/share/safebox/safebox-guest-blocker /usr/bin/safebox
    --ro-bind /usr/share/safebox/safebox-guest-blocker /usr/local/bin/safebox
)

# Ağ İzni
if [ "$NET" = "1" ]; then
    BWRAP_ARGS+=(--share-net --ro-bind-try /etc/resolv.conf /etc/resolv.conf)
fi

# GPU / DRI Aygıtları
if [ -d /dev/dri ]; then
    BWRAP_ARGS+=(--dev-bind /dev/dri /dev/dri)
fi
for nv in /dev/nvidia*; do
    if [ -e "$nv" ]; then
        BWRAP_ARGS+=(--dev-bind "$nv" "$nv")
    fi
done

# Ses Soketi (PulseAudio / PipeWire)
if [ "$AUDIO" = "1" ]; then
    if [ -S "${XDG_RUNTIME_DIR}/pulse/native" ]; then
        BWRAP_ARGS+=(--bind "${XDG_RUNTIME_DIR}/pulse/native" "/run/user/1000/pulse/native" --setenv PULSE_SERVER "unix:/run/user/1000/pulse/native")
    elif [ -S "${XDG_RUNTIME_DIR}/pipewire-0" ]; then
        BWRAP_ARGS+=(--bind "${XDG_RUNTIME_DIR}/pipewire-0" "/run/user/1000/pipewire-0")
    fi
fi

# Paylaşım Klasörü Köprüsü
if [ "$SHARE_FOLDER" = "1" ]; then
    mkdir -p "${HOME}/SafeBox-Paylasim"
    BWRAP_ARGS+=(--bind "${HOME}/SafeBox-Paylasim" "/home/safebox/Paylasim")
fi

# X11 Display Soketi
BWRAP_ARGS+=(--bind "/tmp/.X11-unix/X${TARGET_DISP#:}" "/tmp/.X11-unix/X${TARGET_DISP#:}")

echo "[BİLGİ] Bubblewrap izolasyon kafesi kuruluyor ve MATE başlatılıyor..." >> "$ENGINE_LOG"

# 4. Sanal Masaüstünü Çalıştır
bwrap "${BWRAP_ARGS[@]}" dbus-launch --exit-with-session mate-session >> "$ENGINE_LOG" 2>&1 || true
