#!/usr/bin/env bash
# SafeBox RootFS Kurulum Betiği (v1.7.30)
# Bu betik sandbox için gerekli rootfs'i oluşturur.
# Root (sudo) yetkisi gerektirir.
set -euo pipefail

ROOTFS_DIR="/var/lib/safebox/rootfs"
ROOTFS_TMP="${ROOTFS_DIR}.tmp"
DISTRO="noble"  # Ubuntu 24.04 LTS
AUTO_YES=0

for arg in "$@"; do
    case "$arg" in
        -y|--yes|--force)
            AUTO_YES=1
            ;;
        -h|--help)
            echo "Kullanım: sudo safebox-setup [-y|--yes]"
            exit 0
            ;;
    esac
done

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

print_info()  { echo -e "${BLUE}[BİLGİ]${NC} $1"; }
print_ok()    { echo -e "${GREEN}[  OK ]${NC} $1"; }
print_warn()  { echo -e "${YELLOW}[UYARI]${NC} $1"; }
print_error() { echo -e "${RED}[HATA]${NC} $1"; }

# Root kontrolü
if [ "$(id -u)" -ne 0 ]; then
    print_error "Bu betik root yetkisi gerektirir!"
    echo "Kullanım: sudo safebox-setup"
    exit 1
fi

unmount_rootfs_tmp() {
    local sub target
    for sub in proc dev sys; do
        target="${ROOTFS_TMP}/${sub}"
        if [ -d "$target" ]; then
            if command -v mountpoint >/dev/null 2>&1; then
                if mountpoint -q "$target"; then
                    umount "$target" 2>/dev/null || umount -l "$target" 2>/dev/null || return 1
                fi
            else
                umount "$target" 2>/dev/null || true
            fi
        fi
    done
    return 0
}

safe_remove_tmp() {
    if [ ! -e "$ROOTFS_TMP" ]; then
        return 0
    fi
    if ! unmount_rootfs_tmp; then
        print_error "$ROOTFS_TMP altındaki sanal dosya sistemleri (proc/dev/sys) ayrılamadı; güvenli silme iptal edildi."
        return 1
    fi
    rm -rf "$ROOTFS_TMP"
}

SETUP_COMPLETE=0
CLEANUP_RAN=0

cleanup_on_exit() {
    local rc=$?
    if [ "$CLEANUP_RAN" -eq 1 ]; then
        return 0
    fi
    CLEANUP_RAN=1
    trap - EXIT INT TERM

    unmount_rootfs_tmp || true

    if [ "$SETUP_COMPLETE" -eq 0 ]; then
        safe_remove_tmp || true
        if [ -d "${ROOTFS_DIR}.old" ] && [ ! -d "$ROOTFS_DIR" ]; then
            print_warn "Kurulum başarısız oldu, eski rootfs geri yükleniyor..."
            mv "${ROOTFS_DIR}.old" "$ROOTFS_DIR" || true
        fi
        if [ "$rc" -eq 0 ]; then
            exit 1
        fi
    fi
}

# Zaten kurulu mu kontrol et
if [ -f "$ROOTFS_DIR/.safebox-rootfs-complete" ]; then
    print_warn "RootFS zaten mevcut ve tam: $ROOTFS_DIR"
    if [ "$AUTO_YES" -eq 1 ]; then
        choice="e"
    elif [ -t 0 ]; then
        read -rp "Yeniden oluşturmak istiyor musunuz? [e/H]: " choice || choice=""
    else
        print_error "Etkileşimli olmayan ortamda yeniden kurulum için --yes parametresi gereklidir."
        exit 1
    fi
    if [[ ! "$choice" =~ ^[eEyY]$ ]]; then
        print_info "Kurulum iptal edildi."
        exit 0
    fi
fi

trap cleanup_on_exit EXIT INT TERM

# Yarım kalmış bir geçici klasör varsa önce mountları ayırıp güvenle sil
safe_remove_tmp

if [ -f "$ROOTFS_DIR/.safebox-rootfs-complete" ]; then
    print_info "Mevcut rootfs yedekleniyor (.old)..."
    rm -rf "${ROOTFS_DIR}.old"
    mv "$ROOTFS_DIR" "${ROOTFS_DIR}.old"
elif [ -d "$ROOTFS_DIR" ]; then
    print_info "Tamamlanmamış rootfs bulundu, temizleniyor..."
    rm -rf "$ROOTFS_DIR"
fi

# Bağımlılıkları kontrol et
print_info "Bağımlılıklar kontrol ediliyor..."
MISSING_DEPS=()

for dep in debootstrap bubblewrap Xephyr; do
    case "$dep" in
        Xephyr)
            if ! command -v Xephyr &>/dev/null; then
                MISSING_DEPS+=("xserver-xephyr")
            fi
            ;;
        *)
            if ! command -v "$dep" &>/dev/null; then
                MISSING_DEPS+=("$dep")
            fi
            ;;
    esac
done

if [ ${#MISSING_DEPS[@]} -gt 0 ]; then
    print_info "Eksik paketler kuruluyor: ${MISSING_DEPS[*]}"
    apt-get update -qq
    apt-get install -y -qq "${MISSING_DEPS[@]}"
fi

print_ok "Bağımlılıklar hazır."

# RootFS oluştur — Aşama 1: Minimal sistem
print_info "RootFS oluşturuluyor — Aşama 1: Temel sistem (bu işlem birkaç dakika sürebilir)..."
mkdir -p "$ROOTFS_TMP"

debootstrap \
    --variant=minbase \
    --components=main,universe,restricted,multiverse \
    "$DISTRO" \
    "$ROOTFS_TMP" \
    http://archive.ubuntu.com/ubuntu

print_ok "Temel sistem oluşturuldu."

# Aşama 2: Chroot içinde masaüstü paketlerini kur
# policy-rc.d ile servis başlatmayı engelle (debootstrap hatalarını önler)
print_info "RootFS oluşturuluyor — Aşama 2: Masaüstü ortamı kuruluyor..."

# Servis başlatmayı engelle
cat > "$ROOTFS_TMP/usr/sbin/policy-rc.d" << 'EOF'
#!/bin/sh
exit 101
EOF
chmod +x "$ROOTFS_TMP/usr/sbin/policy-rc.d"

# Chroot içinde DNS çözümlemesi için resolv.conf'u gerçek dosya olarak kopyala
if [ -r /etc/resolv.conf ]; then
    rm -f "$ROOTFS_TMP/etc/resolv.conf"
    cp -L /etc/resolv.conf "$ROOTFS_TMP/etc/resolv.conf"
fi

# /proc, /dev ve /sys geçici olarak bağla
mount --bind /proc "$ROOTFS_TMP/proc"
mount --bind /dev  "$ROOTFS_TMP/dev"
mount --bind /sys  "$ROOTFS_TMP/sys"

# Depo listesini ekle (universe dahil)
cat > "$ROOTFS_TMP/etc/apt/sources.list" << EOF
deb http://archive.ubuntu.com/ubuntu ${DISTRO} main restricted universe multiverse
deb http://archive.ubuntu.com/ubuntu ${DISTRO}-updates main restricted universe multiverse
deb http://security.ubuntu.com/ubuntu ${DISTRO}-security main restricted universe multiverse
EOF

# Masaüstü paketlerini kur
# Not: policy-rc.d sayesinde servis başlatma hataları engellendiği için,
# tam bir cinnamon-core kurulumu güvenle yapılabilir.
chroot "$ROOTFS_TMP" /bin/bash -c "
    export DEBIAN_FRONTEND=noninteractive
    apt-get update -qq

    # Temel masaüstü ortamı (bağımlılık sorunu olmayan paketler)
    apt-get install -y --no-install-recommends \
        cinnamon-core \
        nemo \
        gnome-terminal \
        gnome-system-monitor \
        gedit \
        epiphany-browser \
        adwaita-icon-theme \
        dmz-cursor-theme \
        gnome-themes-extra \
        fonts-liberation \
        dconf-cli \
        dbus-x11 \
        locales \
        fonts-noto \
        yaru-theme-icon \
        yaru-theme-gtk \
        xdg-utils \
        libgtk-3-0 \
        gvfs \
        tumbler

    apt-get clean
    rm -rf /var/lib/apt/lists/*
"

# RootFS bileşenlerini doğrulama
print_info "Cinnamon bileşenleri doğrulanıyor..."
MISSING_BIN=""
for bin in cinnamon cinnamon-session nemo gnome-terminal gnome-system-monitor gedit epiphany dbus-daemon; do
    if [ ! -f "$ROOTFS_TMP/usr/bin/$bin" ] && [ ! -f "$ROOTFS_TMP/bin/$bin" ]; then
        MISSING_BIN="$MISSING_BIN $bin"
    fi
done

if [ -n "$MISSING_BIN" ]; then
    print_error "Eksik bileşenler tespit edildi: $MISSING_BIN"
    print_error "Kurulum başarısız oldu!"
    exit 1
fi

# Gerçek çalışma testleri (version sorgusu)
chroot "$ROOTFS_TMP" cinnamon-session --version > /dev/null 2>&1 || print_warn "cinnamon-session sürüm sorgusu başarısız (Display eksikliği olabilir)"
chroot "$ROOTFS_TMP" cinnamon --version > /dev/null 2>&1 || print_warn "cinnamon sürüm sorgusu başarısız (Display eksikliği olabilir)"
chroot "$ROOTFS_TMP" nemo --version > /dev/null 2>&1 || print_warn "nemo sürüm sorgusu başarısız (Display eksikliği olabilir)"

print_ok "Tüm Cinnamon bileşenleri başarıyla kuruldu ve çalıştırılabilir durumda."

# Servis engelini kaldır
rm -f "$ROOTFS_TMP/usr/sbin/policy-rc.d"
unmount_rootfs_tmp

print_ok "Masaüstü ortamı kuruldu."

# Locale ayarla
print_info "Türkçe dil desteği ayarlanıyor..."
chroot "$ROOTFS_TMP" /bin/bash -c "
    sed -i 's/# tr_TR.UTF-8 UTF-8/tr_TR.UTF-8 UTF-8/' /etc/locale.gen 2>/dev/null || true
    locale-gen tr_TR.UTF-8 2>/dev/null || true
"
print_ok "Dil desteği ayarlandı."

# Gereksiz dosyaları temizle (boyutu küçült)
print_info "Gereksiz dosyalar temizleniyor..."
chroot "$ROOTFS_TMP" /bin/bash -c "
    apt-get clean
    rm -rf /var/lib/apt/lists/*
    rm -rf /usr/share/doc/*
    rm -rf /usr/share/man/*
    rm -rf /var/cache/*
    rm -rf /tmp/*
"
print_ok "Temizlik tamamlandı."

# Kurulumun tamamlandığını belirten bayrak dosyasını ekle
touch "$ROOTFS_TMP/.safebox-rootfs-complete"

# Atomik olarak taşı
rm -rf "$ROOTFS_DIR"
mv "$ROOTFS_TMP" "$ROOTFS_DIR"
SETUP_COMPLETE=1
rm -rf "${ROOTFS_DIR}.old"

# Boyut bilgisi
ROOTFS_SIZE=$(du -sh "$ROOTFS_DIR" 2>/dev/null | cut -f1)
print_ok "RootFS hazır!"

echo ""
echo "════════════════════════════════════════════════"
echo -e "  ${GREEN}✅ SafeBox RootFS kurulumu tamamlandı!${NC}"
echo ""
echo "  Konum : $ROOTFS_DIR"
echo "  Boyut : $ROOTFS_SIZE"
echo "  Distro: Ubuntu $DISTRO (24.04 LTS)"
echo -e "  DE    : Cinnamon"
echo ""
echo "  Artık SafeBox'ı başlatabilirsiniz:"
echo "    safebox"
echo "════════════════════════════════════════════════"
