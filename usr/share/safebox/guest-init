#!/usr/bin/env bash
export HOME=/home/safebox
export USER=safebox
export LOGNAME=safebox

export XDG_DATA_DIRS=/usr/local/share:/usr/share
export XDG_CURRENT_DESKTOP=OPENBOX
export DESKTOP_SESSION=openbox
export LIBGL_ALWAYS_SOFTWARE=1
export GIO_USE_VFS=local
export GVFS_DISABLE_FUSE=1

mkdir -p /home/safebox/Desktop /home/safebox/Downloads /home/safebox/Documents /home/safebox/Paylasim

# Masaüstü Simgeleri
for app in browser home share terminal editor; do
    app_file="/usr/share/applications/${app}.desktop"
    if [ -f "$app_file" ]; then
        cp "$app_file" /home/safebox/Desktop/ 2>/dev/null && chmod +x /home/safebox/Desktop/${app}.desktop 2>/dev/null || true
    fi
done

# GTK Tema ve İkon Ayarları (Görünümün düzelmesi için)
mkdir -p /home/safebox/.config/gtk-3.0
cat > /home/safebox/.config/gtk-3.0/settings.ini << 'EOF'
[Settings]
gtk-theme-name=Adwaita
gtk-icon-theme-name=Adwaita
gtk-font-name=Sans 10
gtk-application-prefer-dark-theme=1
EOF

cat > /home/safebox/.gtkrc-2.0 << 'EOF'
gtk-theme-name="Adwaita"
gtk-icon-theme-name="Adwaita"
gtk-font-name="Sans 10"
EOF

# PCManFM Arkaplan Ayarı (Masaüstü siyah kalmasın diye)
mkdir -p /home/safebox/.config/pcmanfm/default
cat > /home/safebox/.config/pcmanfm/default/desktop-items-0.conf << 'EOF'
[*]
wallpaper_mode=color
desktop_bg=#2c3e50
desktop_shadow=#000000
desktop_fg=#ffffff
EOF

# Güzel bir arkaplan rengi ayarla (pcmanfm devreye girene kadar veya yerine)
if which xsetroot >/dev/null 2>&1; then
    xsetroot -solid "#2c3e50"
fi

# Temel masaüstü bileşenlerini başlat
tint2 &
pcmanfm --desktop &

# Openbox oturum başlat
exec dbus-run-session -- openbox
