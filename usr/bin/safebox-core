#!/usr/bin/env bash
# SafeBox Enterprise Hardened Engine (v1.7.30 - RootFS Hardened)
set -euo pipefail

RAM_GB="${1:-4}"
CPU_CORES="${2:-4}"
RESOLUTION="${3:-1366x768}"
SHARE_FOLDER="${4:-1}"
AUDIO="${5:-1}"
NET="${6:-1}"
SECCOMP="${7:-1}"

ROOTFS="/var/lib/safebox/rootfs"

SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
if [ -n "${SNAP:-}" ] && [ -d "${SNAP}/usr/share/safebox" ]; then
    SHARE_DIR="${SNAP}/usr/share/safebox"
elif [ -d "${SCRIPT_DIR}/../share/safebox" ]; then
    SHARE_DIR="$(cd "${SCRIPT_DIR}/../share/safebox" && pwd)"
else
    SHARE_DIR="/usr/share/safebox"
fi

LOG_DIR="${HOME}/.local/share/safebox"
PROC_MOCK_DIR="${LOG_DIR}/mock_proc"
SYS_MOCK_DIR="${LOG_DIR}/mock_sys"
ETC_MOCK_DIR="${LOG_DIR}/mock_etc"
ENGINE_LOG="${LOG_DIR}/safebox-engine.log"
mkdir -p "$LOG_DIR" "$PROC_MOCK_DIR" "$SYS_MOCK_DIR/devices/system/cpu" "$ETC_MOCK_DIR"

# Kullanıcıya özel çalışma zamanı dizini (multi-user /tmp çakışmasını önler)
if [ -n "${XDG_RUNTIME_DIR:-}" ] && [ -d "${XDG_RUNTIME_DIR}" ] && [ -w "${XDG_RUNTIME_DIR}" ]; then
    RUNTIME_DIR="${XDG_RUNTIME_DIR}/safebox"
else
    RUNTIME_DIR="${LOG_DIR}/run"
fi
mkdir -p "$RUNTIME_DIR"
chmod 700 "$RUNTIME_DIR" 2>/dev/null || true

LOCK_FILE="${RUNTIME_DIR}/safebox.lock"
PID_FILE="${RUNTIME_DIR}/safebox-core.pid"
BWRAP_JSON="${RUNTIME_DIR}/safebox-bwrap.json"
SECCOMP_BPF="${RUNTIME_DIR}/safebox-seccomp.bpf"
XEPHYR_CLOSED_FLAG="${RUNTIME_DIR}/xephyr-closed"

# Giriş doğrulama
if ! [[ "$RAM_GB" =~ ^[1-9][0-9]*$ ]]; then
    echo "[HATA] Geçersiz RAM değeri: $RAM_GB" >> "$ENGINE_LOG"
    exit 108
fi
if ! [[ "$CPU_CORES" =~ ^[1-9][0-9]*$ ]]; then
    echo "[HATA] Geçersiz CPU çekirdek değeri: $CPU_CORES" >> "$ENGINE_LOG"
    exit 108
fi
if ! [[ "$RESOLUTION" =~ ^[0-9]+x[0-9]+$ ]]; then
    echo "[HATA] Geçersiz ekran çözünürlüğü: $RESOLUTION" >> "$ENGINE_LOG"
    exit 108
fi
for flag_val in "$SHARE_FOLDER" "$AUDIO" "$NET" "$SECCOMP"; do
    if [ "$flag_val" != "0" ] && [ "$flag_val" != "1" ]; then
        echo "[HATA] Geçersiz boolean parametre değeri: $flag_val (0 veya 1 olmalı)" >> "$ENGINE_LOG"
        exit 108
    fi
done

if [ ! -f "$ROOTFS/.safebox-rootfs-complete" ] || { [ ! -x "$ROOTFS/bin/bash" ] && [ ! -x "$ROOTFS/usr/bin/bash" ]; } || [ ! -x "$ROOTFS/usr/bin/cinnamon" ]; then
    echo "[HATA] RootFS eksik, bozuk veya temel bileşenler eksik: $ROOTFS" >> "$ENGINE_LOG"
    exit 105
fi

# Tekli oturum kilidi (Race condition önleme - lock dosyası bilerek silinmez)
exec 9>"$LOCK_FILE"
if ! flock -n 9; then
    echo "[HATA] SafeBox zaten çalışıyor. Aynı anda birden fazla oturum açılamaz." >> "$ENGINE_LOG"
    exit 106
fi

# Önceki çökmüş oturumlardan kalma unit varsa temizle (kilit alındıktan sonra güvenli)
systemctl --user stop safebox-app.scope 2>/dev/null || true
systemctl --user reset-failed safebox-app.scope 2>/dev/null || true
rm -f "$BWRAP_JSON" "$SECCOMP_BPF" "$XEPHYR_CLOSED_FLAG"

# Test sistemi için PID kaydet
echo $$ > "$PID_FILE"

echo "=== [$(date '+%Y-%m-%d %H:%M:%S')] SafeBox Engine v1.7.30 Başlatılıyor ===" > "$ENGINE_LOG"

XEPHYR_PID=""
MONITOR_PID=""
TARGET_DISP=""
_CLEANED_UP=0

cleanup() {
    if [ "$_CLEANED_UP" -eq 1 ]; then
        return 0
    fi
    _CLEANED_UP=1
    trap - EXIT INT TERM

    echo "[BİLGİ] Oturum kapatılıyor..." >> "$ENGINE_LOG"
    if [ -n "$MONITOR_PID" ]; then
        kill "$MONITOR_PID" 2>/dev/null || true
    fi
    systemctl --user stop safebox-app.scope 2>/dev/null || true
    systemctl --user reset-failed safebox-app.scope 2>/dev/null || true

    if [ -n "$XEPHYR_PID" ] && kill -0 "$XEPHYR_PID" 2>/dev/null; then
        kill "$XEPHYR_PID" 2>/dev/null || true
        sleep 0.2
        kill -9 "$XEPHYR_PID" 2>/dev/null || true
    fi
    if [ -n "$TARGET_DISP" ]; then
        rm -f "/tmp/.X${TARGET_DISP#:}-lock" 2>/dev/null || true
        rm -rf "/tmp/.X11-unix/X${TARGET_DISP#:}" 2>/dev/null || true
    fi
    rm -f "$PID_FILE" "$BWRAP_JSON" "$SECCOMP_BPF" "$XEPHYR_CLOSED_FLAG" 2>/dev/null || true

    echo "=== [$(date '+%Y-%m-%d %H:%M:%S')] Oturum Kapatıldı ===" >> "$ENGINE_LOG"
}

on_signal() {
    local sig="$1"
    if [ -f "$XEPHYR_CLOSED_FLAG" ]; then
        cleanup
        exit 0
    fi
    cleanup
    if [ "$sig" = "INT" ]; then
        exit 130
    fi
    exit 143
}

trap cleanup EXIT
trap 'on_signal INT' INT
trap 'on_signal TERM' TERM

# Temel host araçlarını doğrula
for req_bin in Xephyr bwrap; do
    if ! command -v "$req_bin" >/dev/null 2>&1; then
        echo "[HATA] Gerekli sistem aracı bulunamadı: $req_bin" >> "$ENGINE_LOG"
        exit 102
    fi
done

# 1. HATA DÜZELTMESİ: Çekirdek Kernel UUID Yedeği
if command -v dbus-uuidgen >/dev/null 2>&1; then
    dbus-uuidgen > "${ETC_MOCK_DIR}/machine-id"
elif command -v uuidgen >/dev/null 2>&1; then
    uuidgen | tr -d '-' > "${ETC_MOCK_DIR}/machine-id"
else
    # /proc/sys/kernel/random/uuid içinde tire olmadan oku (pipefail uyumlu)
    tr -d '-' < /proc/sys/kernel/random/uuid > "${ETC_MOCK_DIR}/machine-id"
fi

cat << 'OS_EOF' > "${ETC_MOCK_DIR}/os-release"
NAME="SafeBox OS"
VERSION="1.7.30 (Hardened Sandbox)"
ID=safebox
ID_LIKE=debian
PRETTY_NAME="SafeBox Hardened Workspace"
OS_EOF

# 2. Sanal Bellek (/proc/meminfo)
TOTAL_KB=$((RAM_GB * 1024 * 1024))
FREE_KB=$((TOTAL_KB * 80 / 100))
AVAIL_KB=$((TOTAL_KB * 75 / 100))

cat << MEM_EOF > "${PROC_MOCK_DIR}/meminfo"
MemTotal:       ${TOTAL_KB} kB
MemFree:        ${FREE_KB} kB
MemAvailable:   ${AVAIL_KB} kB
Buffers:           32000 kB
Cached:           120000 kB
SwapCached:            0 kB
Active:           100000 kB
Inactive:          40000 kB
SwapTotal:             0 kB
SwapFree:              0 kB
MEM_EOF

# 3. HATA DÜZELTMESİ: Gerçek Host Çekirdek Sayısını Aşmayı Engelle (Taskset Crash Fix)
HOST_CORES=$(nproc 2>/dev/null || echo 4)
if [ "$CPU_CORES" -gt "$HOST_CORES" ]; then
    CPU_CORES=$HOST_CORES
fi

rm -f "${PROC_MOCK_DIR}/cpuinfo" "${PROC_MOCK_DIR}/stat"
echo "cpu  2000 0 2000 20000 0 0 0 0 0 0" > "${PROC_MOCK_DIR}/stat"

for ((i=0; i<CPU_CORES; i++)); do
    cat << CPU_EOF >> "${PROC_MOCK_DIR}/cpuinfo"
processor	: $i
vendor_id	: GenuineIntel
cpu family	: 6
model_name	: SafeBox Isolated Virtual Core
stepping	: 1
cpu MHz		: 2500.000
cache size	: 18432 KB
physical id	: 0
siblings	: $CPU_CORES
core id		: $i
cpu cores	: $CPU_CORES
flags		: fpu vme de pse tsc msr pae mce cx8 apic sep mtrr pge mca cmov pat pse36 clflush mmx fxsr sse sse2 ht syscall nx lm constant_tsc rep_good nopl xtopology cpuid pni pclmulqdq ssse3 fma cx16 sse4_1 sse4_2 movbe popcnt aes xsave avx f16c rdrand hypervisor

CPU_EOF
    echo "cpu$i 1000 0 1000 10000 0 0 0 0 0 0" >> "${PROC_MOCK_DIR}/stat"
done
{
    echo "btime $(date +%s)"
    echo "processes 1000"
    echo "procs_running 1"
    echo "procs_blocked 0"
} >> "${PROC_MOCK_DIR}/stat"

MAX_CORE=$((CPU_CORES - 1))
if [ "$MAX_CORE" -lt 0 ]; then MAX_CORE=0; fi
echo "0-${MAX_CORE}" > "${SYS_MOCK_DIR}/devices/system/cpu/online"
CPU_AFFINITY="0-${MAX_CORE}"

# 4. Display Ekranı Bul
for d in $(seq 10 99); do
    if [ ! -e "/tmp/.X11-unix/X$d" ] && [ ! -e "/tmp/.X$d-lock" ]; then
        TARGET_DISP=":$d"
        break
    fi
done

if [ -z "$TARGET_DISP" ]; then
    echo "[HATA] Boş X11 ekranı bulunamadı!" >> "$ENGINE_LOG"
    exit 101
fi

echo "[BİLGİ] Xephyr başlatılıyor: $TARGET_DISP" >> "$ENGINE_LOG"
Xephyr "$TARGET_DISP" -nolisten tcp -screen "$RESOLUTION" -title "SafeBox Secure Workspace ($TARGET_DISP)" -extension MIT-SHM >> "$ENGINE_LOG" 2>&1 &
XEPHYR_PID=$!

# Xephyr hazır olana kadar bekle
XEPHYR_READY=0
HAS_XLSCLIENTS=0
if command -v xlsclients >/dev/null 2>&1; then
    HAS_XLSCLIENTS=1
fi

for ((i=1; i<=50; i++)); do
    if ! kill -0 "$XEPHYR_PID" 2>/dev/null; then
        echo "[HATA] Xephyr süreci başlatılamadı veya erken sonlandı!" >> "$ENGINE_LOG"
        break
    fi
    if [ -e "/tmp/.X11-unix/X${TARGET_DISP#:}" ]; then
        if [ "$HAS_XLSCLIENTS" -eq 1 ]; then
            if env -u XAUTHORITY DISPLAY="$TARGET_DISP" xlsclients >/dev/null 2>&1; then
                XEPHYR_READY=1
                echo "[BİLGİ] Xephyr hazır (Deneme: $i)" >> "$ENGINE_LOG"
                break
            fi
        elif [ "$i" -ge 5 ]; then
            XEPHYR_READY=1
            echo "[BİLGİ] Xephyr soketi hazır (Deneme: $i)" >> "$ENGINE_LOG"
            break
        fi
    fi
    sleep 0.1
done

if [ "$XEPHYR_READY" -eq 0 ]; then
    echo "[HATA] Xephyr başlatılamadı (Timeout veya Çökme)" >> "$ENGINE_LOG"
    exit 102
fi

# Gerekli dosyaların varlığını kontrol et
REQUIRED_DIRS=(
    "${SHARE_DIR}/guest-init"
    "${SHARE_DIR}/welcome.py"
    "${SHARE_DIR}/safebox-guest-blocker"
    "${SHARE_DIR}/seccomp_filter.py"
    "${SHARE_DIR}/guest-etc"
    "${SHARE_DIR}/guest-apps"
)

for dir in "${REQUIRED_DIRS[@]}"; do
    if [ ! -d "$dir" ] && [ ! -f "$dir" ]; then
        echo "[HATA] Gerekli dosya/dizin bulunamadı: $dir" >> "$ENGINE_LOG"
        echo "[UYARI] SafeBox düzgün yüklenmemiş olabilir. Lütfen paketi yeniden kurun." >> "$ENGINE_LOG"
        exit 103
    fi
done

# guest-etc dosyalarının varlığını kontrol et
GUEST_ETC_FILES=("passwd" "group" "shadow" "nsswitch.conf" "hostname" "hosts")
for file in "${GUEST_ETC_FILES[@]}"; do
    if [ ! -f "${SHARE_DIR}/guest-etc/$file" ]; then
        echo "[HATA] ${SHARE_DIR}/guest-etc/$file bulunamadı!" >> "$ENGINE_LOG"
        exit 104
    fi
done

BWRAP_ARGS=(
    --clearenv
    --unshare-user
    --unshare-ipc
    --unshare-pid
    --unshare-uts
    --unshare-cgroup-try
    --uid 1000
    --gid 1000
    --hostname safebox-sandbox
    --ro-bind "$ROOTFS" /
    --ro-bind "${ETC_MOCK_DIR}/machine-id" /etc/machine-id
    --ro-bind "${ETC_MOCK_DIR}/os-release" /etc/os-release
    --ro-bind "${SHARE_DIR}/guest-etc/passwd" /etc/passwd
    --ro-bind "${SHARE_DIR}/guest-etc/group" /etc/group
    --ro-bind "${SHARE_DIR}/guest-etc/shadow" /etc/shadow
    --ro-bind "${SHARE_DIR}/guest-etc/nsswitch.conf" /etc/nsswitch.conf
    --ro-bind "${SHARE_DIR}/guest-etc/hostname" /etc/hostname
    --ro-bind "${SHARE_DIR}/guest-etc/hosts" /etc/hosts
    --dev /dev
    --dev-bind /dev/null /dev/null
    --dev-bind /dev/zero /dev/zero
    --dev-bind /dev/full /dev/full
    --dev-bind /dev/random /dev/random
    --dev-bind /dev/urandom /dev/urandom
    --proc /proc
    --ro-bind "${PROC_MOCK_DIR}/meminfo" /proc/meminfo
    --ro-bind "${PROC_MOCK_DIR}/cpuinfo" /proc/cpuinfo
    --ro-bind "${PROC_MOCK_DIR}/stat" /proc/stat
    --tmpfs /sys
    --ro-bind "${SYS_MOCK_DIR}/devices/system/cpu/online" /sys/devices/system/cpu/online
    --tmpfs /tmp
    --tmpfs /var
    --dir /var/tmp
    --dir /var/lib/dbus
    --ro-bind "${ETC_MOCK_DIR}/machine-id" /var/lib/dbus/machine-id
    --tmpfs /run
    --dir /run/dbus
    --dir /run/user/1000
    --setenv XDG_RUNTIME_DIR /run/user/1000
    --tmpfs /home
    --ro-bind-try /usr/share/icons /usr/share/icons
    --ro-bind-try /usr/share/themes /usr/share/themes
    --dir /home/safebox
    --dir /home/safebox/.local/bin
    --setenv HOME /home/safebox
    --setenv USER safebox
    --setenv LOGNAME safebox
    --setenv DISPLAY "$TARGET_DISP"
    --setenv PATH "/home/safebox/.local/bin:/usr/local/bin:/usr/bin:/bin"
    --setenv SAFEBOX_SHARE "$SHARE_FOLDER"
    --ro-bind "${SHARE_DIR}/guest-apps" /tmp/guest-apps
    --ro-bind "${SHARE_DIR}/safebox-guest-blocker" /home/safebox/.local/bin/safebox
    --die-with-parent
    --new-session
)

# NOT: guest-init içerisinde "CINNAMON_SOFTWARE_RENDERING=1" zorunlu kılındığı için,
# Sandbox stabilitesini korumak adına GPU donanımları /dev içerisine aktarılmaz.
# İzolasyonu artırır ve yazılım tabanlı render ile çelişkiyi engeller.

# Ağ - İzole Namespace (Network Isolation)
if [ "$NET" = "1" ]; then
    echo "[BİLGİ] Ağ namespace'i paylaşılıyor (Ana makine internet erişimi)." >> "$ENGINE_LOG"
    if [ -d /run/systemd/resolve ]; then BWRAP_ARGS+=(--ro-bind /run/systemd/resolve /run/systemd/resolve); fi
    if [ -f /etc/resolv.conf ]; then BWRAP_ARGS+=(--ro-bind-try /etc/resolv.conf /etc/resolv.conf); fi
else
    echo "[BİLGİ] Ağ namespace'i tamamen izole ediliyor (İnternet yok)." >> "$ENGINE_LOG"
    BWRAP_ARGS+=(--unshare-net)
fi

# Ses - XDG_RUNTIME_DIR kontrolü (host değişkenini bozmadan oku)
if [ "$AUDIO" = "1" ]; then
    HOST_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
    # PulseAudio Soket
    if [ -S "${HOST_RUNTIME_DIR}/pulse/native" ]; then
        echo "[BİLGİ] PulseAudio soketi bulundu" >> "$ENGINE_LOG"
        BWRAP_ARGS+=(--bind "${HOST_RUNTIME_DIR}/pulse/native" "/run/user/1000/pulse/native" --setenv PULSE_SERVER "unix:/run/user/1000/pulse/native")
    # PipeWire Soket
    elif [ -S "${HOST_RUNTIME_DIR}/pipewire-0" ]; then
        echo "[BİLGİ] PipeWire soketi bulundu" >> "$ENGINE_LOG"
        BWRAP_ARGS+=(--bind "${HOST_RUNTIME_DIR}/pipewire-0" "/run/user/1000/pipewire-0" --setenv PIPEWIRE_REMOTE "/run/user/1000/pipewire-0")
    else
        echo "[UYARI] Aktif bir ses soketi bulunamadı!" >> "$ENGINE_LOG"
    fi
fi

# Paylaşım Klasörü
if [ "$SHARE_FOLDER" = "1" ]; then
    SHARE_DIR_HOST="${HOME}/SafeBox-Paylasim"
    mkdir -p "$SHARE_DIR_HOST"
    BWRAP_ARGS+=(--bind "$SHARE_DIR_HOST" "/home/safebox/Paylasim")
    echo "[BİLGİ] Paylaşım klasörü bağlandı: $SHARE_DIR_HOST -> /home/safebox/Paylasim" >> "$ENGINE_LOG"
else
    echo "[BİLGİ] Paylaşım klasörü kapalı." >> "$ENGINE_LOG"
fi

# X11 Socket
BWRAP_ARGS+=(--bind "/tmp/.X11-unix/X${TARGET_DISP#:}" "/tmp/.X11-unix/X${TARGET_DISP#:}")
BWRAP_ARGS+=(--info-fd 8)
if [ "$SECCOMP" = "1" ]; then
    if python3 "${SHARE_DIR}/seccomp_filter.py" -o "$SECCOMP_BPF" >> "$ENGINE_LOG" 2>&1; then
        BWRAP_ARGS+=(--seccomp 7)
        echo "[BİLGİ] Seccomp BPF filtresi etkinleştirildi." >> "$ENGINE_LOG"
    else
        echo "[HATA] Seccomp BPF filtresi oluşturulamadı!" >> "$ENGINE_LOG"
        exit 109
    fi
else
    echo "[UYARI] Seccomp BPF filtresi kullanıcı tercihiyle devre dışı bırakıldı." >> "$ENGINE_LOG"
fi
BWRAP_ARGS+=(--ro-bind "${SHARE_DIR}/guest-init" /home/safebox/.local/bin/guest-init)

# Xephyr penceresi kapandığında (kullanıcı kapattığında) Sandbox'ı otomatik sonlandır
CORE_PID=$$
(
    trap - EXIT INT TERM
    exec 9>&-
    while kill -0 "$XEPHYR_PID" 2>/dev/null; do
        sleep 1
    done
    echo "[BİLGİ] Xephyr kapandı. Sandbox durduruluyor..." >> "$ENGINE_LOG"
    touch "$XEPHYR_CLOSED_FLAG" 2>/dev/null || true
    systemctl --user stop safebox-app.scope 2>/dev/null || true
    sleep 1
    if kill -0 "$CORE_PID" 2>/dev/null; then
        kill -TERM "$CORE_PID" 2>/dev/null || true
    fi
) &
MONITOR_PID=$!

echo "[BİLGİ] Sandbox başlatılıyor..." >> "$ENGINE_LOG"

# Cgroup CPU limit
CPU_QUOTA_VAL=$((CPU_CORES * 100))

echo "[BİLGİ] Çalıştırma zinciri başlatılıyor..." >> "$ENGINE_LOG"
CMD_BWRAP=(bwrap "${BWRAP_ARGS[@]}" /home/safebox/.local/bin/guest-init)

run_success=0
if command -v systemd-run >/dev/null 2>&1; then
    # systemd-run --scope ekstra FD'leri kapatabileceği için --info-fd (8) ve --seccomp (7) bash içinden açılır
    if [ "$SECCOMP" = "1" ]; then
        # shellcheck disable=SC2016
        CMD_SYSTEMD=(systemd-run --user --scope --unit=safebox-app.scope -p "MemoryMax=${RAM_GB}G" -p "CPUQuota=${CPU_QUOTA_VAL}%" bash -c 'exec 8> "$1" && exec 7< "$2" && shift 2 && exec "$@"' _ "$BWRAP_JSON" "$SECCOMP_BPF" "${CMD_BWRAP[@]}")
    else
        # shellcheck disable=SC2016
        CMD_SYSTEMD=(systemd-run --user --scope --unit=safebox-app.scope -p "MemoryMax=${RAM_GB}G" -p "CPUQuota=${CPU_QUOTA_VAL}%" bash -c 'exec 8> "$1" && shift && exec "$@"' _ "$BWRAP_JSON" "${CMD_BWRAP[@]}")
    fi

    echo "[BİLGİ] systemd-run ile deneniyor..." >> "$ENGINE_LOG"
    set +e
    taskset -c "$CPU_AFFINITY" "${CMD_SYSTEMD[@]}" >> "$ENGINE_LOG" 2>&1
    RET=$?
    set -e
    if [ "$RET" -eq 0 ]; then
        run_success=1
    elif [ -f "$XEPHYR_CLOSED_FLAG" ] || ! kill -0 "$XEPHYR_PID" 2>/dev/null; then
        echo "[BİLGİ] Xephyr penceresi kapatıldığı için oturum sonlandırıldı." >> "$ENGINE_LOG"
        run_success=1
    else
        echo "[HATA] systemd-run başarısız oldu (Hata Kodu: $RET)" >> "$ENGINE_LOG"
    fi
fi

if [ "$run_success" -eq 0 ]; then
    echo "[HATA] Güvenlik politikası (Cgroup/systemd-run) uygulanamadığı için başlatma iptal edildi." >> "$ENGINE_LOG"
    exit 107
fi
