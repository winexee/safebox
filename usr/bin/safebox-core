#!/usr/bin/env bash
# SafeBox Robust Engine & Virtual Machine Runtime Core (v1.4.7)
set -e

RAM_GB="${1:-4}"
CPU_CORES="${2:-4}"
RESOLUTION="${3:-1366x768}"
SHARE_FOLDER="${4:-1}"
CLIPBOARD="${5:-1}"
AUDIO="${6:-1}"
NET="${7:-1}"

LOG_DIR="${HOME}/.local/share/safebox"
ENGINE_LOG="${LOG_DIR}/safebox-engine.log"
mkdir -p "$LOG_DIR"

echo "=== [$(date '+%Y-%m-%d %H:%M:%S')] SafeBox Sanal Makine Başlatılıyor ===" > "$ENGINE_LOG"

# 1. Boş bir DISPLAY ekran numarası bul
TARGET_DISP=""
for d in $(seq 10 99); do
    if [ ! -e "/tmp/.X11-unix/X$d" ] && [ ! -e "/tmp/.X$d-lock" ]; then
        TARGET_DISP=":$d"
        break
    fi
done

if [ -z "$TARGET_DISP" ]; then
    echo "[HATA] Boş bir sanal ekran bulunamadı!" >> "$ENGINE_LOG"
    exit 101
fi
echo "[BİLGİ] Sanal X11 Display atandı: $TARGET_DISP" >> "$ENGINE_LOG"

# 2. Xephyr Başlat
Xephyr "$TARGET_DISP" -screen "$RESOLUTION" -ac -title "SafeBox Virtual Desktop ($TARGET_DISP)" -resizeable >> "$ENGINE_LOG" 2>&1 &
XEPHYR_PID=$!

cleanup() {
    echo "[BİLGİ] Oturum kapatılıyor, süreçler temizleniyor..." >> "$ENGINE_LOG"
    kill -9 "$XEPHYR_PID" 2>/dev/null || true
    echo "=== [$(date '+%Y-%m-%d %H:%M:%S')] Sanal Makine Güvenle Kapatıldı ===" >> "$ENGINE_LOG"
}
trap cleanup EXIT INT TERM

for i in {1..25}; do
    if [ -e "/tmp/.X11-unix/X${TARGET_DISP#:}" ]; then break; fi
    sleep 0.2
done

# 3. İzole Bubblewrap Parametreleri
BWRAP_ARGS=(
    --ro-bind /usr /usr
    --ro-bind /lib /lib
    --ro-bind /lib64 /lib64
    --ro-bind /bin /bin
    --ro-bind /sbin /sbin
    --ro-bind /etc /etc
    --dev /dev
    --proc /proc
    --tmpfs /tmp
    --tmpfs /var
    --tmpfs /run
    --dir /run/user/1000
    --setenv XDG_RUNTIME_DIR /run/user/1000
    --tmpfs /home
    --dir /home/safebox
    --dir /home/safebox/.local/bin
    --setenv HOME /home/safebox
    --setenv USER safebox
    --setenv LOGNAME safebox
    --setenv DISPLAY "$TARGET_DISP"
    --setenv XDG_DATA_DIRS "/home/safebox/.local/share:/usr/share"
    --setenv PATH "/home/safebox/.local/bin:/usr/local/bin:/usr/bin:/bin"
    --ro-bind /usr/share/safebox/safebox-guest-blocker /home/safebox/.local/bin/safebox
    --unshare-all
    --die-with-parent
    --new-session
)

# DNS ve Ağ
if [ "$NET" = "1" ]; then
    BWRAP_ARGS+=(--share-net)
    if [ -d /run/systemd/resolve ]; then
        BWRAP_ARGS+=(--ro-bind /run/systemd/resolve /run/systemd/resolve)
    fi
    if [ -f /etc/resolv.conf ]; then
        BWRAP_ARGS+=(--ro-bind-try /etc/resolv.conf /etc/resolv.conf)
    fi
fi

# GPU / DRI
if [ -d /dev/dri ]; then
    BWRAP_ARGS+=(--dev-bind /dev/dri /dev/dri)
fi
for nv in /dev/nvidia*; do
    if [ -e "$nv" ]; then
        BWRAP_ARGS+=(--dev-bind "$nv" "$nv")
    fi
done

# Ses Soketi
if [ "$AUDIO" = "1" ]; then
    if [ -S "${XDG_RUNTIME_DIR}/pulse/native" ]; then
        BWRAP_ARGS+=(--bind "${XDG_RUNTIME_DIR}/pulse/native" "/run/user/1000/pulse/native" --setenv PULSE_SERVER "unix:/run/user/1000/pulse/native")
    elif [ -S "${XDG_RUNTIME_DIR}/pipewire-0" ]; then
        BWRAP_ARGS+=(--bind "${XDG_RUNTIME_DIR}/pipewire-0" "/run/user/1000/pipewire-0")
    fi
fi

# Paylaşım Klasörü
if [ "$SHARE_FOLDER" = "1" ]; then
    mkdir -p "${HOME}/SafeBox-Paylasim"
    BWRAP_ARGS+=(--bind "${HOME}/SafeBox-Paylasim" "/home/safebox/Paylasim")
fi

# X11 Socket
BWRAP_ARGS+=(--bind "/tmp/.X11-unix/X${TARGET_DISP#:}" "/tmp/.X11-unix/X${TARGET_DISP#:}")

echo "[BİLGİ] Sanal masaüstü izole oturumla başlatılıyor..." >> "$ENGINE_LOG"

# 4. İzole Oturum Başlatıcıyı Çağır
bwrap "${BWRAP_ARGS[@]}" dbus-launch --exit-with-session /usr/share/safebox/guest-init >> "$ENGINE_LOG" 2>&1 || true
