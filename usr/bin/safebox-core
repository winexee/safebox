#!/usr/bin/env bash
# SafeBox Enterprise Hardened Engine (v1.7.6 - Security & Stability)
set -euo pipefail

RAM_GB="${1:-4}"
CPU_CORES="${2:-4}"
RESOLUTION="${3:-1366x768}"
SHARE_FOLDER="${4:-1}"
CLIPBOARD="${5:-1}"
AUDIO="${6:-1}"
NET="${7:-1}"

LOG_DIR="${HOME}/.local/share/safebox"
PROC_MOCK_DIR="${LOG_DIR}/mock_proc"
SYS_MOCK_DIR="${LOG_DIR}/mock_sys"
ETC_MOCK_DIR="${LOG_DIR}/mock_etc"
ENGINE_LOG="${LOG_DIR}/safebox-engine.log"
mkdir -p "$LOG_DIR" "$PROC_MOCK_DIR" "$SYS_MOCK_DIR/devices/system/cpu" "$ETC_MOCK_DIR"

echo "=== [$(date '+%Y-%m-%d %H:%M:%S')] SafeBox Engine v1.7.1 Başlatılıyor ===" > "$ENGINE_LOG"

# 1. HATA DÜZELTMESİ: Çekirdek Kernel UUID Yedeği
if which dbus-uuidgen >/dev/null 2>&1; then
    dbus-uuidgen > "${ETC_MOCK_DIR}/machine-id"
else
    cat /proc/sys/kernel/random/uuid > "${ETC_MOCK_DIR}/machine-id"
fi

cat << 'OS_EOF' > "${ETC_MOCK_DIR}/os-release"
NAME="SafeBox OS"
VERSION="1.7.1 (Hardened Sandbox)"
ID=safebox
ID_LIKE=debian
PRETTY_NAME="SafeBox Hardened Workspace"
OS_EOF

# 2. Sanal Bellek (/proc/meminfo)
TOTAL_KB=$((RAM_GB * 1024 * 1024))
FREE_KB=$((TOTAL_KB * 80 / 100))
AVAIL_KB=$((TOTAL_KB * 75 / 100))

cat << MEM_EOF > "${PROC_MOCK_DIR}/meminfo"
MemTotal:       ${TOTAL_KB} kB
MemFree:        ${FREE_KB} kB
MemAvailable:   ${AVAIL_KB} kB
Buffers:           32000 kB
Cached:           120000 kB
SwapCached:            0 kB
Active:           100000 kB
Inactive:          40000 kB
SwapTotal:             0 kB
SwapFree:              0 kB
MEM_EOF

# 3. HATA DÜZELTMESİ: Gerçek Host Çekirdek Sayısını Aşmayı Engelle (Taskset Crash Fix)
HOST_CORES=$(nproc 2>/dev/null || echo 4)
if [ "$CPU_CORES" -gt "$HOST_CORES" ]; then
    CPU_CORES=$HOST_CORES
fi

rm -f "${PROC_MOCK_DIR}/cpuinfo" "${PROC_MOCK_DIR}/stat"
echo "cpu  2000 0 2000 20000 0 0 0 0 0 0" > "${PROC_MOCK_DIR}/stat"

for ((i=0; i<CPU_CORES; i++)); do
    cat << CPU_EOF >> "${PROC_MOCK_DIR}/cpuinfo"
processor	: $i
vendor_id	: GenuineIntel
cpu family	: 6
model_name	: SafeBox Isolated Virtual Core
stepping	: 1
cpu MHz		: 2500.000
cache size	: 18432 KB
physical id	: 0
siblings	: $CPU_CORES
core id		: $i
cpu cores	: $CPU_CORES
flags		: fpu vme de pse tsc msr pae mce cx8 apic sep mtrr pge mca cmov pat pse36 clflush mmx fxsr sse sse2 ht syscall nx lm constant_tsc rep_good nopl xtopology cpuid pni pclmulqdq ssse3 fma cx16 sse4_1 sse4_2 movbe popcnt aes xsave avx f16c rdrand hypervisor

CPU_EOF
    echo "cpu$i 1000 0 1000 10000 0 0 0 0 0 0" >> "${PROC_MOCK_DIR}/stat"
done

MAX_CORE=$((CPU_CORES - 1))
if [ "$MAX_CORE" -lt 0 ]; then MAX_CORE=0; fi
echo "0-${MAX_CORE}" > "${SYS_MOCK_DIR}/devices/system/cpu/online"
CPU_AFFINITY="0-${MAX_CORE}"

# 4. Display Ekranı Bul
TARGET_DISP=""
for d in $(seq 10 99); do
    if [ ! -e "/tmp/.X11-unix/X$d" ] && [ ! -e "/tmp/.X$d-lock" ]; then
        TARGET_DISP=":$d"
        break
    fi
done

if [ -z "$TARGET_DISP" ]; then
    echo "[HATA] Boş X11 ekranı bulunamadı!" >> "$ENGINE_LOG"
    exit 101
fi

echo "[BİLGİ] Xephyr başlatılıyor: $TARGET_DISP" >> "$ENGINE_LOG"
Xephyr "$TARGET_DISP" -screen "$RESOLUTION" -title "SafeBox Secure Workspace ($TARGET_DISP)" -resizeable >> "$ENGINE_LOG" 2>&1 &
XEPHYR_PID=$!

# Dönüş değerini kontrol et
if ! kill -0 "$XEPHYR_PID" 2>/dev/null; then
    echo "[HATA] Xephyr process başlatılamadı!" >> "$ENGINE_LOG"
    exit 102
fi

cleanup() {
    echo "[BİLGİ] Oturum kapatılıyor..." >> "$ENGINE_LOG"
    kill -9 "$XEPHYR_PID" 2>/dev/null || true
    # X11 Lock dosyasını temizle
    rm -f "/tmp/.X${TARGET_DISP#:}-lock" 2>/dev/null || true
    rm -rf "/tmp/.X11-unix/X${TARGET_DISP#:}" 2>/dev/null || true
    echo "=== [$(date '+%Y-%m-%d %H:%M:%S')] Oturum Kapatıldı ===" >> "$ENGINE_LOG"
}
trap cleanup EXIT INT TERM

# Xephyr hazır olana kadar bekle (Geliştirilmiş)
XEPHYR_READY=0
for i in {1..50}; do
    if [ -e "/tmp/.X11-unix/X${TARGET_DISP#:}" ]; then
        # Ek kontrol: Socket'ı test et
        if DISPLAY="$TARGET_DISP" xlsclients >/dev/null 2>&1 || [ $i -gt 30 ]; then
            XEPHYR_READY=1
            echo "[BİLGİ] Xephyr hazır (Deneme: $i)" >> "$ENGINE_LOG"
            break
        fi
    fi
    sleep 0.1
done

if [ "$XEPHYR_READY" -eq 0 ]; then
    echo "[HATA] Xephyr başlatılamadı (Timeout)" >> "$ENGINE_LOG"
    exit 102
fi

# 5. HATA DÜZELTMESİ: --dev /dev Geri Getirildi (Terminal PTS çökmelerini önler)
# Gerekli dosyalar var mı kontrol et
REQUIRED_DIRS=(
    "/usr/share/safebox/guest-etc"
    "/usr/share/safebox/guest-apps"
    "/usr/share/safebox/safebox-guest-blocker"
)

for dir in "${REQUIRED_DIRS[@]}"; do
    if [ ! -d "$dir" ] && [ ! -f "$dir" ]; then
        echo "[HATA] Gerekli dosya/dizin bulunamadı: $dir" >> "$ENGINE_LOG"
        echo "[UYARI] SafeBox düzgün yüklenmemiş olabilir. Lütfen paketi yeniden kurun." >> "$ENGINE_LOG"
        exit 103
    fi
done

# guest-etc dosyalarının varlığını kontrol et
GUEST_ETC_FILES=("passwd" "group" "shadow" "nsswitch.conf" "hostname" "hosts")
for file in "${GUEST_ETC_FILES[@]}"; do
    if [ ! -f "/usr/share/safebox/guest-etc/$file" ]; then
        echo "[HATA] /usr/share/safebox/guest-etc/$file bulunamadı!" >> "$ENGINE_LOG"
        exit 104
    fi
done

BWRAP_ARGS=(
    --unshare-all
    --uid 1000
    --gid 1000
    --hostname safebox-sandbox
    --ro-bind /usr /usr
    --ro-bind /lib /lib
    --ro-bind /lib64 /lib64
    --ro-bind /bin /bin
    --ro-bind /sbin /sbin
    --ro-bind /etc /etc
    --ro-bind "${ETC_MOCK_DIR}/machine-id" /etc/machine-id
    --ro-bind "${ETC_MOCK_DIR}/os-release" /etc/os-release
    --ro-bind /usr/share/safebox/guest-etc/passwd /etc/passwd
    --ro-bind /usr/share/safebox/guest-etc/group /etc/group
    --ro-bind /usr/share/safebox/guest-etc/shadow /etc/shadow
    --ro-bind /usr/share/safebox/guest-etc/nsswitch.conf /etc/nsswitch.conf
    --ro-bind /usr/share/safebox/guest-etc/hostname /etc/hostname
    --ro-bind /usr/share/safebox/guest-etc/hosts /etc/hosts
    --tmpfs /dev
    --dev-bind /dev/null /dev/null
    --dev-bind /dev/zero /dev/zero
    --dev-bind /dev/full /dev/full
    --dev-bind /dev/random /dev/random
    --dev-bind /dev/urandom /dev/urandom
    --dev-bind /dev/pts /dev/pts
    --proc /proc
    --ro-bind "${PROC_MOCK_DIR}/meminfo" /proc/meminfo
    --ro-bind "${PROC_MOCK_DIR}/cpuinfo" /proc/cpuinfo
    --ro-bind "${PROC_MOCK_DIR}/stat" /proc/stat
    --tmpfs /sys
    --ro-bind "${SYS_MOCK_DIR}/devices/system/cpu/online" /sys/devices/system/cpu/online
    --tmpfs /tmp
    --tmpfs /var
    --tmpfs /run
    --dir /run/user/1000
    --setenv XDG_RUNTIME_DIR /run/user/1000
    --tmpfs /home
    --dir /home/safebox
    --dir /home/safebox/.local/bin
    --setenv HOME /home/safebox
    --setenv USER safebox
    --setenv LOGNAME safebox
    --setenv DISPLAY "$TARGET_DISP"
    --setenv PATH "/home/safebox/.local/bin:/usr/local/bin:/usr/bin:/bin"
    --tmpfs /usr/share/applications
    --ro-bind /usr/share/safebox/guest-apps /usr/share/applications
    --ro-bind /usr/share/safebox/safebox-guest-blocker /home/safebox/.local/bin/safebox
    --die-with-parent
    --new-session
)

# Kontrollü /dev/dri Düğümleri
if [ -e /dev/dri/renderD128 ]; then BWRAP_ARGS+=(--dev-bind /dev/dri/renderD128 /dev/dri/renderD128); fi
if [ -e /dev/dri/card0 ]; then BWRAP_ARGS+=(--dev-bind /dev/dri/card0 /dev/dri/card0); fi

# Kontrollü NVIDIA Düğümleri
for nv_node in /dev/nvidia0 /dev/nvidiactl /dev/nvidia-modeset /dev/nvidia-uvm; do
    if [ -e "$nv_node" ]; then BWRAP_ARGS+=(--dev-bind "$nv_node" "$nv_node"); fi
done

# Ağ - İzole Namespace (Network Isolation)
# Not: --unshare-all ile ağ namespace'i varsayılan olarak izole edilmiştir
# NET=1 seçilirse, DNS erişimi sağlanırken network izolasyonu korunur
if [ "$NET" = "1" ]; then
    if [ -d /run/systemd/resolve ]; then BWRAP_ARGS+=(--ro-bind /run/systemd/resolve /run/systemd/resolve); fi
    if [ -f /etc/resolv.conf ]; then BWRAP_ARGS+=(--ro-bind-try /etc/resolv.conf /etc/resolv.conf); fi
    echo "[BİLGİ] Ağ namespace'i izole (DNS erişimi: etkin)" >> "$ENGINE_LOG"
else
    echo "[BİLGİ] Ağ erişimi kapatıldı" >> "$ENGINE_LOG"
fi

# Ses - XDG_RUNTIME_DIR kontrolü
if [ "$AUDIO" = "1" ]; then
    # XDG_RUNTIME_DIR belirlenmişse kullan, yoksa varsayılanı ayarla
    if [ -z "${XDG_RUNTIME_DIR:-}" ]; then
        XDG_RUNTIME_DIR="/run/user/$(id -u)"
        echo "[UYARI] XDG_RUNTIME_DIR belirlenmedi, ayarlanıyor: $XDG_RUNTIME_DIR" >> "$ENGINE_LOG"
    fi
    
    # PulseAudio Soket
    if [ -S "${XDG_RUNTIME_DIR}/pulse/native" ]; then
        echo "[BİLGİ] PulseAudio soketi bulundu" >> "$ENGINE_LOG"
        BWRAP_ARGS+=(--bind "${XDG_RUNTIME_DIR}/pulse/native" "/run/user/1000/pulse/native" --setenv PULSE_SERVER "unix:/run/user/1000/pulse/native")
    # PipeWire Soket
    elif [ -S "${XDG_RUNTIME_DIR}/pipewire-0" ]; then
        echo "[BİLGİ] PipeWire soketi bulundu" >> "$ENGINE_LOG"
        BWRAP_ARGS+=(--bind "${XDG_RUNTIME_DIR}/pipewire-0" "/run/user/1000/pipewire-0")
    else
        echo "[UYARI] Ses soketi bulunamadı (PulseAudio/PipeWire)" >> "$ENGINE_LOG"
    fi
fi

# Clipboard Eriş imi
# Not: Clipboard socket'ı /tmp/.X11-unix üzerinden geçiyor
# CLIPBOARD=1 ise, host clipboard'u sandbox'ta erişilebilir
if [ "$CLIPBOARD" = "1" ]; then
    # X11 clipboard manager socket (varsa)
    if [ -e "${XDG_RUNTIME_DIR}/X11" ]; then
        BWRAP_ARGS+=(--bind "${XDG_RUNTIME_DIR}/X11" "/run/user/1000/X11")
    fi
    echo "[BİLGİ] Clipboard erişimi etkin (Dikkat: Host ↔ Sandbox)" >> "$ENGINE_LOG"
else
    echo "[BİLGİ] Clipboard erişimi kapatıldı (Güvenli mod)" >> "$ENGINE_LOG"
fi

# Paylaşım Klasörü
if [ "$SHARE_FOLDER" = "1" ]; then
    mkdir -p "${HOME}/SafeBox-Paylasim"
    BWRAP_ARGS+=(--bind "${HOME}/SafeBox-Paylasim" "/home/safebox/Paylasim")
fi

# X11 Socket
BWRAP_ARGS+=(--bind "/tmp/.X11-unix/X${TARGET_DISP#:}" "/tmp/.X11-unix/X${TARGET_DISP#:}")

# 6. cgroup v2 Gerçek Sınırlandırma ile Başlat
CPU_QUOTA_VAL=$((CPU_CORES * 100))
SYSTEMD_ARGS=(
    --user
    --scope
    -p "MemoryMax=${RAM_GB}G"
    -p "CPUQuota=${CPU_QUOTA_VAL}%"
)

if which systemd-run >/dev/null 2>&1; then
    taskset -c "$CPU_AFFINITY" systemd-run "${SYSTEMD_ARGS[@]}" bwrap "${BWRAP_ARGS[@]}" dbus-run-session -- /usr/share/safebox/guest-init >> "$ENGINE_LOG" 2>&1
else
    taskset -c "$CPU_AFFINITY" bwrap "${BWRAP_ARGS[@]}" dbus-run-session -- /usr/share/safebox/guest-init >> "$ENGINE_LOG" 2>&1
fi
