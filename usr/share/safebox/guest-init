#!/usr/bin/env bash
set -euo pipefail

export HOME=/home/safebox
export USER=safebox
export LOGNAME=safebox

export XDG_CONFIG_HOME="$HOME/.config"
export XDG_CACHE_HOME="$HOME/.cache"
export XDG_DATA_HOME="$HOME/.local/share"
export XDG_DATA_DIRS="/opt:/usr/local/share:/usr/share"

export XDG_SESSION_TYPE=x11
export XDG_CURRENT_DESKTOP=X-Cinnamon
export XDG_SESSION_DESKTOP=cinnamon
export DESKTOP_SESSION=cinnamon

# Host Cinnamon/ICE oturum bilgisini guest'e taşımama.
unset SESSION_MANAGER
unset DBUS_SESSION_BUS_ADDRESS


# Cinnamon-session için private ICE authority.
export ICEAUTHORITY="$HOME/.ICEauthority"
touch "$ICEAUTHORITY"
chmod 600 "$ICEAUTHORITY"


export GIO_USE_VFS=local
export GVFS_DISABLE_FUSE=1

# Önce stabil Cinnamon varsayılanlarıyla başlayalım.
# Tema özelleştirmesini session çalıştıktan sonra ayrı ele alacağız.
export GTK_THEME="Yaru-dark"

mkdir -p \
    "$HOME/Desktop" \
    "$HOME/Masaüstü" \
    "$HOME/Belgeler" \
    "$HOME/Documents" \
    "$HOME/İndirilenler" \
    "$HOME/Downloads" \
    "$HOME/Resimler" \
    "$HOME/Pictures" \
    "$HOME/.config/gtk-3.0" \
    "$HOME/.config/gtk-4.0" \
    "$HOME/.config/cinnamon" \
    "$HOME/.cache" \
    "$HOME/.local/share"

cat > "$HOME/.config/gtk-3.0/settings.ini" <<'GTK3_EOF'
[Settings]
gtk-theme-name=Yaru-dark
gtk-icon-theme-name=Yaru
gtk-font-name=Ubuntu 10
gtk-application-prefer-dark-theme=1
GTK3_EOF

cat > "$HOME/.config/gtk-4.0/settings.ini" <<'GTK4_EOF'
[Settings]
gtk-theme-name=Yaru-dark
gtk-icon-theme-name=Yaru
gtk-font-name=Ubuntu 10
gtk-application-prefer-dark-theme=1
GTK4_EOF

rm -f "$HOME/Desktop/"*.desktop "$HOME/Masaüstü/"*.desktop 2>/dev/null || true

for app in browser home share terminal editor monitor; do
    if [ -f "/usr/share/safebox/guest-apps/${app}.desktop" ]; then
        cp "/usr/share/safebox/guest-apps/${app}.desktop" "$HOME/Desktop/" 2>/dev/null || true
        cp "/usr/share/safebox/guest-apps/${app}.desktop" "$HOME/Masaüstü/" 2>/dev/null || true
    fi
done

chmod +x "$HOME/Desktop/"*.desktop "$HOME/Masaüstü/"*.desktop 2>/dev/null || true

# Cinnamon'u doğrudan özel session D-Bus altında başlat.
# cinnamon-session kullanılmaz; test edilen rootless-Xorg yoludur.

unset SESSION_MANAGER
unset DBUS_SESSION_BUS_ADDRESS

exec dbus-run-session -- bash -c '
    # SafeBox guest paneli için host/default applet listesini ez.
    # printers ve network appletleri guest içinde bulunmayan servisler
    # istediği için bilinçli olarak devre dışı bırakılır.

    gsettings set org.cinnamon enabled-applets "[
      '\''panel1:left:0:menu@cinnamon.org:0'\'',
      '\''panel1:left:1:separator@cinnamon.org:1'\'',
      '\''panel1:left:2:grouped-window-list@cinnamon.org:2'\'',
      '\''panel1:right:0:systray@cinnamon.org:3'\'',
      '\''panel1:right:1:xapp-status@cinnamon.org:4'\'',
      '\''panel1:right:2:notifications@cinnamon.org:5'\'',
      '\''panel1:right:3:removable-drives@cinnamon.org:6'\'',
      '\''panel1:right:4:keyboard@cinnamon.org:7'\'',
      '\''panel1:right:5:favorites@cinnamon.org:8'\'',
      '\''panel1:right:6:sound@cinnamon.org:9'\'',
      '\''panel1:right:7:power@cinnamon.org:10'\'',
      '\''panel1:right:8:calendar@cinnamon.org:11'\'',
      '\''panel1:right:9:cornerbar@cinnamon.org:12'\''
    ]"

    # Host duvar kağıdını kullanma; SafeBox için düz koyu arka plan.
    gsettings set org.cinnamon.desktop.background picture-uri "" 2>/dev/null || true
    gsettings set org.cinnamon.desktop.background picture-uri-dark "" 2>/dev/null || true
    gsettings set org.cinnamon.desktop.background primary-color "#202020" 2>/dev/null || true
    gsettings set org.cinnamon.desktop.background secondary-color "#202020" 2>/dev/null || true
    gsettings set org.cinnamon.desktop.background color-shading-type "solid" 2>/dev/null || true

    echo "[OK] SafeBox Cinnamon panel ayarları uygulandı."

    exec cinnamon --sm-disable
'
