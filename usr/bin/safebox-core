#!/bin/bash
RAM_GB=${1:-4}
CPU_COUNT=${2:-4}
SCREEN_RES=${3:-"1366x768"}
SHARE_FOLDER=${4:-"1"}
CLIPBOARD=${5:-"1"}
AUDIO=${6:-"1"}
NET=${7:-"1"}

LOG_DIR="$HOME/.local/share/safebox"
LOG_FILE="$LOG_DIR/safebox.log"
mkdir -p "$LOG_DIR"

log() {
  echo "[$(date "+%Y-%m-%d %H:%M:%S")] $1" >> "$LOG_FILE"
}

log "=== SafeBox MATE İzole Oturumu Başlatılıyor ==="
log "Sistem Parametreleri: RAM=${RAM_GB}GB, CPU=${CPU_COUNT} Thread, Çözünürlük=${SCREEN_RES}"

SANDBOX_HOME=$(mktemp -d /tmp/safebox_home_XXXXXX)
SANDBOX_TMP=$(mktemp -d /tmp/safebox_tmp_XXXXXX)
SANDBOX_RUN=$(mktemp -d /tmp/safebox_run_XXXXXX)
SANDBOX_ETC=$(mktemp -d /tmp/safebox_etc_XXXXXX)
SANDBOX_APPS=$(mktemp -d /tmp/safebox_apps_XXXXXX)

mkdir -p "$SANDBOX_RUN/user/1000"
chmod 700 "$SANDBOX_RUN/user/1000"

echo "safebox:x:1000:1000:SafeBox Guvenli Kullanici,,,:/home/safebox:/bin/bash" > "$SANDBOX_ETC/passwd"
echo "safebox:x:1000:" > "$SANDBOX_ETC/group"

mkdir -p "$SANDBOX_HOME/Desktop" "$SANDBOX_HOME/Downloads" "$SANDBOX_HOME/Documents"
mkdir -p "$SANDBOX_HOME/.config/gtk-3.0" "$SANDBOX_HOME/.config/dconf" "$SANDBOX_HOME/.local/share/applications"

# 1. Yalnızca İstenen 5 Temel Uygulama

# Firefox
cat << 'APP' > "$SANDBOX_APPS/firefox.desktop"
[Desktop Entry]
Version=1.0
Name=Firefox Web Tarayıcısı
Exec=firefox %u
Icon=firefox
Terminal=false
Type=Application
Categories=Network;WebBrowser;
APP

# Caja Dosya Yöneticisi
cat << 'APP' > "$SANDBOX_APPS/caja.desktop"
[Desktop Entry]
Version=1.0
Name=Dosyalar (Caja)
Exec=caja --no-desktop
Icon=system-file-manager
Terminal=false
Type=Application
Categories=System;FileManager;
APP

# MATE Uçbirim
cat << 'APP' > "$SANDBOX_APPS/mate-terminal.desktop"
[Desktop Entry]
Version=1.0
Name=MATE Uçbirim
Exec=mate-terminal
Icon=utilities-terminal
Terminal=false
Type=Application
Categories=System;TerminalEmulator;
APP

# Resim Görüntüleyici (Eye of MATE)
cat << 'APP' > "$SANDBOX_APPS/eom.desktop"
[Desktop Entry]
Version=1.0
Name=Resim Görüntüleyici
Exec=eom %U
Icon=eom
Terminal=false
Type=Application
Categories=Graphics;Viewer;
APP

# Video Oynatıcı
VIDEO_BIN=$(which celluloid totem mpv vlc 2>/dev/null | head -n1)
VIDEO_CMD=${VIDEO_BIN:-"celluloid"}
cat << APP > "$SANDBOX_APPS/video.desktop"
[Desktop Entry]
Version=1.0
Name=Video Oynatıcı
Exec=$VIDEO_CMD %U
Icon=video-player
Terminal=false
Type=Application
Categories=AudioVideo;Player;
APP

# Kısayolları masaüstüne ve yerel havuza yerleştir
cp "$SANDBOX_APPS/"*.desktop "$SANDBOX_HOME/.local/share/applications/"
cp "$SANDBOX_APPS/"*.desktop "$SANDBOX_HOME/Desktop/"
chmod +x "$SANDBOX_HOME/Desktop/"*.desktop "$SANDBOX_APPS/"*.desktop

# GTK3 Yaru-dark Modern Tema
cat << CFG > "$SANDBOX_HOME/.config/gtk-3.0/settings.ini"
[Settings]
gtk-theme-name=Yaru-dark
gtk-icon-theme-name=Yaru
gtk-font-name=Ubuntu 10
gtk-cursor-theme-name=Yaru
gtk-application-prefer-dark-theme=true
CFG

cat << CFG > "$SANDBOX_HOME/.gtkrc-2.0"
gtk-theme-name="Yaru-dark"
gtk-icon-theme-name="Yaru"
gtk-font-name="Ubuntu 10"
CFG

EXTRA_BINDS=()
if [ "$SHARE_FOLDER" = "1" ]; then
  REAL_SHARE="$HOME/SafeBox-Paylasim"
  mkdir -p "$REAL_SHARE"
  mkdir -p "$SANDBOX_HOME/Paylasilan-Klasor"
  EXTRA_BINDS+=(--bind "$REAL_SHARE" "$SANDBOX_HOME/Paylasilan-Klasor")
  ln -s /home/safebox/Paylasilan-Klasor "$SANDBOX_HOME/Desktop/Paylaşılan Klasör" 2>/dev/null
  log "[KÖPRÜ] Paylaşılan klasör bağlandı: ~/SafeBox-Paylasim -> ~/Paylasilan-Klasor"
fi

if [ "$AUDIO" = "1" ]; then
  EXTRA_BINDS+=(--ro-bind-try "$XDG_RUNTIME_DIR/pulse" "$XDG_RUNTIME_DIR/pulse")
  EXTRA_BINDS+=(--ro-bind-try "$XDG_RUNTIME_DIR/pipewire-0" "$XDG_RUNTIME_DIR/pipewire-0")
  log "[SES] Ses soketleri aktarıldı."
fi

NET_FLAG="--unshare-net"
if [ "$NET" = "1" ]; then
  NET_FLAG="--share-net"
  log "[AĞ] İnternet erişimi etkin."
else
  log "[AĞ] Ağ tamamen izole edildi (Air-Gapped)."
fi

NVIDIA_FLAGS=()
for dev in /dev/nvidia*; do
  if [ -e "$dev" ]; then
    NVIDIA_FLAGS+=(--dev-bind-try "$dev" "$dev")
  fi
done

SANDBOX_DISPLAY=":100"

Xephyr -br -ac -noreset -extension MIT-SHM -screen "$SCREEN_RES" -title "SafeBox - Guvenli Sanal Alan ($SCREEN_RES)" "$SANDBOX_DISPLAY" 2>/dev/null &
XEPHYR_PID=$!
log "[EKRAN] Xephyr Sanal X Sunucusu ($SANDBOX_DISPLAY) açıldı (PID: $XEPHYR_PID)."

sleep 1

cat << 'STARTUP' > "$SANDBOX_HOME/.xinitrc"
#!/bin/bash
export XDG_CURRENT_DESKTOP="MATE"
export XDG_DATA_DIRS=/usr/share/mate:/usr/local/share/:/usr/share/
export GDK_SYNCHRONIZE=1

for f in /home/safebox/Desktop/*.desktop; do
  gio set "$f" metadata::trusted true 2>/dev/null || true
done

marco --replace &
caja --no-default-window &
mate-panel &

wait
STARTUP
chmod +x "$SANDBOX_HOME/.xinitrc"

log "[İZOLE KATMAN] Menüsüz, sade ve tam izole MATE Masaüstü başlatılıyor..."

bwrap \
  --ro-bind /usr /usr \
  --ro-bind /lib /lib \
  --ro-bind /lib64 /lib64 \
  --ro-bind /bin /bin \
  --ro-bind /sbin /sbin \
  --ro-bind /etc /etc \
  --ro-bind "$SANDBOX_ETC/passwd" /etc/passwd \
  --ro-bind "$SANDBOX_ETC/group" /etc/group \
  --proc /proc \
  --dev /dev \
  --dev-bind-try /dev/dri /dev/dri \
  --dev-bind-try /dev/shm /dev/shm \
  "${NVIDIA_FLAGS[@]}" \
  --bind "$SANDBOX_HOME" /home/safebox \
  --bind "$SANDBOX_TMP" /tmp \
  --bind "$SANDBOX_RUN" /run \
  "${EXTRA_BINDS[@]}" \
  --ro-bind-try /tmp/.X11-unix /tmp/.X11-unix \
  --ro-bind-try /etc/fonts /etc/fonts \
  --ro-bind-try /usr/share/fonts /usr/share/fonts \
  --ro-bind-try /usr/share/themes /usr/share/themes \
  --ro-bind-try /usr/share/icons /usr/share/icons \
  --ro-bind-try /usr/share/backgrounds /usr/share/backgrounds \
  --ro-bind-try /usr/share/mate /usr/share/mate \
  --ro-bind-try /usr/share/mate-panel /usr/share/mate-panel \
  --ro-bind-try /usr/share/glib-2.0 /usr/share/glib-2.0 \
  --ro-bind "$SANDBOX_APPS" /usr/share/applications \
  --ro-bind-try /usr/lib/mate-panel /usr/lib/mate-panel \
  --ro-bind-try /usr/libexec/mate-panel /usr/libexec/mate-panel \
  --unshare-all \
  $NET_FLAG \
  --hostname SafeBox \
  --setenv HOME "/home/safebox" \
  --setenv USER "safebox" \
  --setenv LOGNAME "safebox" \
  --setenv XDG_RUNTIME_DIR "/run/user/1000" \
  --setenv DISPLAY "$SANDBOX_DISPLAY" \
  dbus-run-session -- /home/safebox/.xinitrc 2>/dev/null

log "[KAPANIŞ] Sanal alan sonlandırıldı. Geçici RAM alanları temizleniyor..."
kill "$XEPHYR_PID" 2>/dev/null
rm -rf "$SANDBOX_HOME" "$SANDBOX_TMP" "$SANDBOX_RUN" "$SANDBOX_ETC" "$SANDBOX_APPS"
log "[KAPANIŞ] Tüm geçici RAM diskleri ve artıklar sıfırlandı. Oturum güvenle kapandı."
log "========================================================="
